@@ -0,0 +1,18 @@
+## A board-local position. Two identical cells on different boards are distinct positions.
+extends RefCounted
+class_name BoardPosition
+
+var board_id: String = ""
+var cell: Vector2i = Vector2i(-1, -1)
+
+func _init(id: String = "", local_cell: Vector2i = Vector2i(-1, -1)) -> void:
+	board_id = id
+	cell = local_cell
+
+static func from_unit(unit: BaseCombatant) -> BoardPosition:
+	if unit == null or not is_instance_valid(unit):
+		return BoardPosition.new()
+	return BoardPosition.new(unit.board_id, unit.board_anchor)
+
+func equals(other: BoardPosition) -> bool:
+	return other != null and board_id == other.board_id and cell == other.cell
diff --git a/scripts/combat/board/BoardPositionQueries.gd b/scripts/combat/board/BoardPositionQueries.gd
new file mode 100644
--- /dev/null
+++ b/scripts/combat/board/BoardPositionQueries.gd
@@ -0,0 +1,58 @@
+## Pure footprint-aware position queries; hypothetical anchors never move a live unit.
+extends RefCounted
+class_name BoardPositionQueries
+
+static func opponents(a: BaseCombatant, b: BaseCombatant) -> bool:
+	return a != null and b != null and a.faction != b.faction and a.faction != BaseCombatant.FACTIONS.NEUTRAL and b.faction != BaseCombatant.FACTIONS.NEUTRAL
+
+static func count_adjacent(board: BoardData, around: BaseCombatant, faction: String = "ANY", hypothetical_anchor: Vector2i = BaseCombatant.BOARD_ANCHOR_NONE) -> int:
+	if board == null or around == null or not board.has_unit(around):
+		return 0
+	var count: int = 0
+	for unit: BaseCombatant in board.get_units():
+		if unit == around or not unit.is_alive() or board.unit_distance(around, unit, hypothetical_anchor) != 1:
+			continue
+		if faction == "ANY" or (faction == "ALLY" and unit.faction == around.faction) or (faction == "OPPONENT" and opponents(around, unit)):
+			count += 1
+	return count
+
+static func surrounded_count(board: BoardData, target: BaseCombatant) -> int:
+	return count_adjacent(board, target, "OPPONENT")
+
+## PINCER requires the attacker itself and a living ally touching opposite cardinal sides.
+## Large footprints are compared by their exposed edges, not only their anchors.
+static func is_flanked(board: BoardData, attacker: BaseCombatant, target: BaseCombatant, hypothetical_anchor: Vector2i = BaseCombatant.BOARD_ANCHOR_NONE) -> bool:
+	if board == null or attacker == null or target == null or not board.has_unit(attacker) or not board.has_unit(target) or not opponents(attacker, target):
+		return false
+	var anchor: Vector2i = attacker.board_anchor if hypothetical_anchor == BaseCombatant.BOARD_ANCHOR_NONE else hypothetical_anchor
+	var sides: Array[Vector2i] = _contact_sides(anchor, attacker.footprint, target.board_anchor, target.footprint)
+	if sides.is_empty():
+		return false
+	for ally: BaseCombatant in board.get_units():
+		if ally == attacker or ally == target or not ally.is_alive() or ally.faction != attacker.faction:
+			continue
+		var ally_sides: Array[Vector2i] = _contact_sides(ally.board_anchor, ally.footprint, target.board_anchor, target.footprint)
+		for side: Vector2i in sides:
+			if ally_sides.has(-side):
+				return true
+	return false
+
+static func _contact_sides(anchor: Vector2i, footprint: Vector2i, target: Vector2i, target_size: Vector2i) -> Array[Vector2i]:
+	var returned: Array[Vector2i] = []
+	var overlap_x: bool = anchor.x < target.x + target_size.x and target.x < anchor.x + footprint.x
+	var overlap_y: bool = anchor.y < target.y + target_size.y and target.y < anchor.y + footprint.y
+	if overlap_x and anchor.y + footprint.y == target.y:
+		returned.append(Vector2i.UP)
+	if overlap_x and target.y + target_size.y == anchor.y:
+		returned.append(Vector2i.DOWN)
+	if overlap_y and anchor.x + footprint.x == target.x:
+		returned.append(Vector2i.LEFT)
+	if overlap_y and target.x + target_size.x == anchor.x:
+		returned.append(Vector2i.RIGHT)
+	return returned
+
+static func is_on_edge(board: BoardData, unit: BaseCombatant) -> bool:
+	if board == null or unit == null or not board.has_unit(unit):
+		return false
+	var anchor: Vector2i = unit.board_anchor
+	return anchor.x == 0 or anchor.y == 0 or anchor.x + unit.footprint.x == board.size.x or anchor.y + unit.footprint.y == board.size.y
diff --git a/scripts/combat/board/CombatBattlefield.gd b/scripts/combat/board/CombatBattlefield.gd
new file mode 100644
--- /dev/null
+++ b/scripts/combat/board/CombatBattlefield.gd
@@ -0,0 +1,164 @@
+## Owns independent boards for one combat. Geometry mutations are synchronous and emit no
+## gameplay events; action owners dispatch leave/enter only after a complete successful commit.
+## Action owners enforce alive/immovable/interceptor rules; placement also serves pre-ready units.
+extends RefCounted
+class_name CombatBattlefield
+
+const BOARD_SHARED: String = "shared"
+const BOARD_PARTY: String = "party"
+const BOARD_ENEMY: String = "enemy"
+
+var boards: Dictionary[String, BoardData] = {}
+var rules: CombatRulesData = null
+var encounter: EncounterData = null
+var valid: bool = false
+var error: String = ""
+var board_mode: int = CombatRulesData.BOARD_MODES.DUAL
+
+func _init(encounter_data: EncounterData = null, combat_rules: CombatRulesData = null) -> void:
+	rules = combat_rules if combat_rules != null else CombatRulesData.new()
+	encounter = encounter_data if encounter_data != null else EncounterData.new()
+	error = rules.validate_configuration()
+	if error == "":
+		error = encounter.validate_configuration(rules)
+	if error != "":
+		return
+	board_mode = encounter.get_board_mode(rules)
+	var ids: Array[String] = [BOARD_SHARED]
+	if board_mode == CombatRulesData.BOARD_MODES.DUAL:
+		ids.assign([BOARD_PARTY, BOARD_ENEMY])
+	for id: String in ids:
+		var board := BoardData.new(encounter.get_size_for_board(id, rules), rules)
+		board.board_id = id
+		for cell: Vector2i in EncounterData.cells_from_json(encounter.get_board_config(id).blocked_cells):
+			board.set_blocked(cell)
+		boards[id] = board
+	valid = true
+
+static func get_active() -> CombatBattlefield:
+	var director: CombatDirector = Global.get_combat_director()
+	return director.battlefield if director != null else null
+
+func get_board(id: String) -> BoardData:
+	return boards.get(id, null)
+
+func get_board_for_unit(unit: BaseCombatant) -> BoardData:
+	if unit == null or not is_instance_valid(unit):
+		return null
+	var board: BoardData = get_board(unit.board_id)
+	return board if board != null and board.has_unit(unit) and board.get_unit_at(unit.board_anchor) == unit else null
+
+func get_units() -> Array[BaseCombatant]:
+	var returned: Array[BaseCombatant] = []
+	for board: BoardData in boards.values():
+		for unit: BaseCombatant in board.get_units():
+			if not returned.has(unit):
+				returned.append(unit)
+	return returned
+
+## Initial deployment only. Never use faction to locate a unit that already exists.
+func default_board_id(faction: int) -> String:
+	if board_mode == CombatRulesData.BOARD_MODES.SINGLE:
+		return BOARD_SHARED
+	return BOARD_PARTY if faction == BaseCombatant.FACTIONS.PARTY else BOARD_ENEMY
+
+func get_position(unit: BaseCombatant) -> BoardPosition:
+	return BoardPosition.from_unit(unit) if get_board_for_unit(unit) != null else BoardPosition.new()
+
+func place(unit: BaseCombatant, position: BoardPosition) -> bool:
+	if not valid or unit == null or not is_instance_valid(unit) or position == null:
+		return false
+	for existing: BoardData in boards.values():
+		if existing.unit_cells.has(unit.unit_uid) or existing._uid_to_unit.has(unit.unit_uid):
+			return false
+	var board: BoardData = get_board(position.board_id)
+	if board == null or not board.place(unit, position.cell):
+		return false
+	unit.board_id = position.board_id
+	return true
+
+func can_transfer(unit: BaseCombatant, destination: BoardPosition) -> bool:
+	if destination == null or get_board_for_unit(unit) == null:
+		return false
+	var target: BoardData = get_board(destination.board_id)
+	return target != null and target.can_teleport(unit, destination.cell)
+
+func transfer(unit: BaseCombatant, destination: BoardPosition) -> bool:
+	if not can_transfer(unit, destination):
+		return false
+	var source: BoardData = get_board_for_unit(unit)
+	var target: BoardData = get_board(destination.board_id)
+	var old: BoardPosition = BoardPosition.from_unit(unit)
+	var snapshots: Array[Dictionary] = [_snapshot(source)]
+	if source != target:
+		snapshots.append(_snapshot(target))
+	source.remove(unit)
+	if not target.place(unit, destination.cell):
+		_restore(snapshots)
+		unit.board_id = old.board_id
+		unit.board_anchor = old.cell
+		return false
+	unit.board_id = destination.board_id
+	return true
+
+func transfer_unit(unit: BaseCombatant, target_board_id: String, target_cell: Vector2i) -> bool:
+	return transfer(unit, BoardPosition.new(target_board_id, target_cell))
+
+func can_swap(a: BaseCombatant, b: BaseCombatant) -> bool:
+	if a == null or b == null or not is_instance_valid(a) or not is_instance_valid(b):
+		return false
+	if a == b or a.footprint != b.footprint:
+		return false
+	var board_a: BoardData = get_board_for_unit(a)
+	var board_b: BoardData = get_board_for_unit(b)
+	if board_a == null or board_b == null:
+		return false
+	if not board_b.can_teleport(a, b.board_anchor, [b]) or not board_a.can_teleport(b, a.board_anchor, [a]):
+		return false
+	if board_a == board_b:
+		var cells_a: Array[Vector2i] = BoardData.footprint_cells(b.board_anchor, a.footprint)
+		for cell: Vector2i in BoardData.footprint_cells(a.board_anchor, b.footprint):
+			if cells_a.has(cell):
+				return false
+	return true
+
+func swap(a: BaseCombatant, b: BaseCombatant) -> bool:
+	if not can_swap(a, b):
+		return false
+	var board_a: BoardData = get_board_for_unit(a)
+	var board_b: BoardData = get_board_for_unit(b)
+	var old_a: BoardPosition = BoardPosition.from_unit(a)
+	var old_b: BoardPosition = BoardPosition.from_unit(b)
+	var snapshots: Array[Dictionary] = [_snapshot(board_a)]
+	if board_a != board_b:
+		snapshots.append(_snapshot(board_b))
+	board_a.remove(a)
+	board_b.remove(b)
+	if not board_b.place(a, old_b.cell) or not board_a.place(b, old_a.cell):
+		_restore(snapshots)
+		a.board_id = old_a.board_id
+		a.board_anchor = old_a.cell
+		b.board_id = old_b.board_id
+		b.board_anchor = old_b.cell
+		return false
+	a.board_id = old_b.board_id
+	b.board_id = old_a.board_id
+	return true
+
+func swap_units(a: BaseCombatant, b: BaseCombatant) -> bool:
+	return swap(a, b)
+
+## Snapshot only geometry; rollback cannot replay or undo gameplay events because none run here.
+static func _snapshot(board: BoardData) -> Dictionary:
+	var occupants: Dictionary = {}
+	for cell: Vector2i in board.cells:
+		occupants[cell] = board.cells[cell].occupant_uid
+	return {"board": board, "occupants": occupants, "unit_cells": board.unit_cells.duplicate(true), "units": board._uid_to_unit.duplicate()}
+
+static func _restore(snapshots: Array[Dictionary]) -> void:
+	for snapshot: Dictionary in snapshots:
+		var board: BoardData = snapshot.board
+		board.unit_cells.assign(snapshot.unit_cells)
+		board._uid_to_unit.assign(snapshot.units)
+		for cell: Vector2i in snapshot.occupants:
+			board.cells[cell].occupant_uid = snapshot.occupants[cell]
diff --git a/scripts/combat/board/CrossBoardPolicy.gd b/scripts/combat/board/CrossBoardPolicy.gd
new file mode 100644
--- /dev/null
+++ b/scripts/combat/board/CrossBoardPolicy.gd
@@ -0,0 +1,37 @@
+## The one targeting geometry entry point. Version 1 implements SELECT_TARGET_CELL only.
+## Faction, unit existence and card/action-specific permissions remain caller validations.
+extends RefCounted
+class_name CrossBoardPolicy
+
+const VERSION: int = 1
+const SELECT_TARGET_CELL: String = "SELECT_TARGET_CELL"
+
+static func resolve(battlefield: CombatBattlefield, source: BoardPosition, target: BoardPosition, shape: int, max_range: int = -1, footprint: Vector2i = Vector2i.ONE, movement: String = "") -> Dictionary:
+	if battlefield == null or not battlefield.valid:
+		return _rejected("invalid_battlefield")
+	var configuration_error: String = battlefield.rules.validate_configuration()
+	if configuration_error != "":
+		return _rejected(configuration_error)
+	if source == null or target == null:
+		return _rejected("off_board")
+	var source_board: BoardData = battlefield.get_board(source.board_id)
+	var target_board: BoardData = battlefield.get_board(target.board_id)
+	if source_board == null or target_board == null or not source_board.is_in_bounds(source.cell) or not target_board.is_in_bounds(target.cell):
+		return _rejected("off_board")
+	if shape not in BoardTargeting.TARGET_SHAPES.values():
+		return _rejected("unknown_shape")
+	var cross_board: bool = source.board_id != target.board_id
+	if cross_board and (shape in [BoardTargeting.TARGET_SHAPES.LINE, BoardTargeting.TARGET_SHAPES.LINE_PIERCE] or movement in ["PUSH", "PULL", "PULL_ADJACENT"]):
+		return _rejected("cross_board_direction_unsupported")
+	if shape == BoardTargeting.TARGET_SHAPES.SELF_AREA:
+		target_board = source_board
+		target = source
+		cross_board = false
+	if not cross_board and max_range >= 0 and source_board.footprint_distance_to_cell(source.cell, footprint, target.cell) > max_range:
+		return _rejected("out_of_range")
+	var cells: Array[Vector2i] = BoardTargeting.cells_in_shape(target_board, source.cell, target.cell, shape, max_range)
+	var distance: Variant = null if cross_board else source_board.footprint_distance_to_cell(source.cell, footprint, target.cell)
+	return {"valid": true, "error": "", "cross_board": cross_board, "board_id": target.board_id, "cells": cells, "distance": distance}
+
+static func _rejected(reason: String) -> Dictionary:
+	return {"valid": false, "error": reason, "cross_board": false, "board_id": "", "cells": [], "distance": null}
diff --git a/scripts/combat/board/FieldActionCells.gd b/scripts/combat/board/FieldActionCells.gd
new file mode 100644
--- /dev/null
+++ b/scripts/combat/board/FieldActionCells.gd
@@ -0,0 +1,52 @@
+## Shared cell input for field creation/removal/obstacle actions; never mutates targeting state.
+extends RefCounted
+class_name FieldActionCells
+
+## Explicit identity always wins and never falls back on a miss. Selection identifies
+## the target board; absent selection uses the creator's actual board, not its faction.
+static func resolve_board(action: BaseAction, explicit_id: Variant = null) -> BoardData:
+	var battlefield: CombatBattlefield = CombatBattlefield.get_active()
+	if battlefield == null:
+		return null
+	if explicit_id != null:
+		return battlefield.get_board(str(explicit_id))
+	if action.card_play_request != null and action.card_play_request.selected_board_id != "":
+		return battlefield.get_board(action.card_play_request.selected_board_id)
+	if is_instance_valid(action.parent_combatant):
+		return battlefield.get_board_for_unit(action.parent_combatant)
+	return null
+
+static func resolve_effect_board(action: BaseAction, explicit_id: Variant, cell_value: Variant) -> BoardData:
+	var selected: BoardData = resolve_board(action, explicit_id)
+	if selected != null and cell_value == null and action.card_play_request != null and action.card_play_request.card_data != null:
+		return BoardTargeting.target_board_for_shape(selected, action.parent_combatant, action.card_play_request.card_data.card_shape)
+	return selected
+
+static func resolve(action: BaseAction, board: BoardData, value: Variant, shape_default: bool = false) -> Array[Vector2i]:
+	var cells: Array[Vector2i] = []
+	var parent: BaseCombatant = action.parent_combatant
+	var request: CardPlayRequest = action.card_play_request
+	if value is String:
+		if value == "PARENT_CELL" and is_instance_valid(parent) and board.has_unit(parent):
+			cells.append(parent.board_anchor)
+		elif value == "SELECTED_CELL" and request != null and (request.selected_board_id == "" or request.selected_board_id == board.board_id):
+			cells.append(request.selected_cell)
+	elif value is Vector2i or value is Vector2:
+		cells.append(Vector2i(value))
+	elif value is Array:
+		cells = EncounterData.cells_from_json(value)
+	elif value == null and shape_default and request != null:
+		var selected: Vector2i = request.selected_cell
+		if selected == BaseCombatant.BOARD_ANCHOR_NONE and is_instance_valid(request.selected_target):
+			selected = request.selected_target.board_anchor
+		var shape: int = request.card_data.card_shape if request.card_data != null else BoardTargeting.TARGET_SHAPES.SINGLE
+		var maximum_range: int = request.card_data.card_range if request.card_data != null else -1
+		var geometry: Dictionary = BoardTargeting.geometry(board, parent, selected, shape, maximum_range)
+		if not geometry.get("valid", false) or geometry.get("board_id", "") != board.board_id:
+			return []
+		cells.assign(geometry.get("cells", []))
+	var result: Array[Vector2i] = []
+	for cell: Vector2i in cells:
+		if board.is_in_bounds(cell) and not result.has(cell):
+			result.append(cell)
+	return result
diff --git a/scripts/combat/board/FieldClockAction.gd b/scripts/combat/board/FieldClockAction.gd
new file mode 100644
--- /dev/null
+++ b/scripts/combat/board/FieldClockAction.gd
@@ -0,0 +1,45 @@
+## Dynamically advances all boards' field clocks together. After each boundary its
+## entire generated subtree completes, then the next boundary is selected afresh.
+## Newly created/refreshed fields therefore behave identically in bulk and small steps.
+extends BaseAction
+class_name FieldClockAction
+
+var _controllers: Array[WeakRef] = []
+var _generations: Array[int] = []
+var previous_tick: int
+var target_tick: int
+
+func _init(controllers: Array[FieldController], previous: int, target: int) -> void:
+	previous_tick = previous
+	target_tick = target
+	resolve_children_immediately = true
+	for controller: FieldController in controllers:
+		_controllers.append(weakref(controller))
+		_generations.append(controller.generation)
+
+func perform_action() -> void:
+	if target_tick <= previous_tick:
+		return
+	var chosen: Dictionary = {}
+	var controller: FieldController = null
+	for index: int in _controllers.size():
+		var candidate: FieldController = _controllers[index].get_ref()
+		if candidate == null or not candidate.active or candidate.generation != _generations[index]:
+			continue
+		var boundary: Dictionary = candidate.next_tick_boundary(previous_tick, target_tick)
+		# Equal ticks retain board insertion order; each controller retains field order.
+		if not boundary.is_empty() and (chosen.is_empty() or boundary.tick < chosen.tick):
+			chosen = boundary
+			controller = candidate
+	if chosen.is_empty():
+		return
+	var instance: FieldInstance = chosen.instance
+	if chosen.event == "tick":
+		var interval: int = instance.field_data.field_tick_interval
+		instance.next_tick = int(chosen.tick) + interval if interval > 0 else -1
+	var event := FieldEventAction.new(controller, chosen.event, instance.cell, null, instance)
+	event.scheduled_revision = instance.revision
+	event.scheduled_tick = chosen.tick
+	# This clock intentionally carries no one field's owner/cancellation scope. Individual
+	# events have their own scope; all boards' generations are rechecked on every iteration.
+	ActionHandler.add_ordered_actions([event, self])
diff --git a/scripts/combat/board/FieldController.gd b/scripts/combat/board/FieldController.gd
new file mode 100644
--- /dev/null
+++ b/scripts/combat/board/FieldController.gd
@@ -0,0 +1,181 @@
+## Per-combat fields. Director calls clock/stay/spawn explicitly; movement supplies each
+## leave/enter boundary. Queued events use weak ownership and a generation cancellation gate.
+extends RefCounted
+class_name FieldController
+
+var _board_ref: WeakRef
+var generation: int = 0
+var active: bool = true
+var board: BoardData:
+	get:
+		return _board_ref.get_ref() if _board_ref != null else null
+
+func _init(combat_board: BoardData) -> void:
+	_board_ref = weakref(combat_board)
+	combat_board.field_controller = weakref(self)
+
+static func get_active() -> FieldController:
+	return for_board(BoardData.get_active())
+
+static func for_board(current: BoardData) -> FieldController:
+	return current.field_controller.get_ref() if current != null and current.field_controller != null else null
+
+static func get_for_unit(unit: BaseCombatant) -> FieldController:
+	var battlefield: CombatBattlefield = CombatBattlefield.get_active()
+	return for_board(battlefield.get_board_for_unit(unit)) if battlefield != null else null
+
+func create_field(data: FieldData, cell: Vector2i, owner: BaseCombatant = null,
+		current_tick: int = 0, duration_override: int = -2) -> FieldInstance:
+	if not active or board == null or data == null or not board.is_in_bounds(cell):
+		return null
+	for existing: FieldInstance in board.get_fields(cell):
+		if existing.field_data.object_id != data.object_id:
+			continue
+		match data.field_stack_policy:
+			FieldData.STACK_POLICIES.IGNORE:
+				return existing
+			FieldData.STACK_POLICIES.STACK:
+				existing.stacks += 1
+				existing.refresh(current_tick, duration_override)
+				Signals.field_changed.emit(existing)
+				if existing.expires_tick == current_tick:
+					remove_field(existing)
+				return existing
+			_:
+				remove_field(existing)
+	if not active or board == null:
+		return null
+	var instance := FieldInstance.new(data, cell, owner, current_tick, duration_override)
+	instance.board_id = board.board_id
+	if not board.fields.has(cell):
+		board.fields[cell] = []
+	board.fields[cell].append(instance)
+	Signals.field_created.emit(instance)
+	# A zero-duration field is observable as created/removed, but cannot trigger effects.
+	if instance.expires_tick == current_tick:
+		remove_field(instance)
+	return instance
+
+func has_field(instance: FieldInstance) -> bool:
+	return active and board != null and board.get_fields(instance.cell).has(instance)
+
+func remove_field(instance: FieldInstance) -> bool:
+	if board == null or not board.get_fields(instance.cell).has(instance):
+		return false
+	board.fields[instance.cell].erase(instance)
+	if board.fields[instance.cell].is_empty():
+		board.fields.erase(instance.cell)
+	Signals.field_removed.emit(instance)
+	return true
+
+func remove_fields(cells: Array[Vector2i] = [], field_id: String = "", tag: String = "") -> int:
+	var removed: int = 0
+	for instance: FieldInstance in _all_fields():
+		if not cells.is_empty() and not cells.has(instance.cell):
+			continue
+		if field_id != "" and instance.field_data.object_id != field_id:
+			continue
+		if tag != "" and not instance.field_data.field_tags.has(tag):
+			continue
+		if remove_field(instance):
+			removed += 1
+	return removed
+
+## The mover calls the leave half before changing occupancy, and the enter half afterwards.
+## intermediate=true skips ordinary fields but still emits the public cell crossing signal.
+func make_movement_actions(unit: BaseCombatant, from: Vector2i, to: Vector2i,
+		entering: bool, intermediate: bool, parent_action: BaseAction = null) -> Array[BaseAction]:
+	var result: Array[BaseAction] = []
+	if not active or not is_instance_valid(unit) or from == to:
+		return result
+	var old_cells: Array[Vector2i] = BoardData.footprint_cells(from, unit.footprint)
+	var new_cells: Array[Vector2i] = BoardData.footprint_cells(to, unit.footprint)
+	var changed: Array[Vector2i] = new_cells if entering else old_cells
+	var retained: Array[Vector2i] = old_cells if entering else new_cells
+	for cell: Vector2i in changed:
+		if not retained.has(cell):
+			result.append(FieldEventAction.new(self, "enter" if entering else "leave", cell, unit, null, intermediate, parent_action))
+	return result
+
+## Transfer has already atomically committed occupancy. Even equal local coordinates
+## on different boards represent distinct cells, so there is no footprint intersection.
+func make_transfer_actions(unit: BaseCombatant, anchor: Vector2i, entering: bool,
+		parent_action: BaseAction = null) -> Array[BaseAction]:
+	var result: Array[BaseAction] = []
+	if not active or not is_instance_valid(unit):
+		return result
+	for cell: Vector2i in BoardData.footprint_cells(anchor, unit.footprint):
+		result.append(FieldEventAction.new(self, "enter" if entering else "leave", cell, unit, null, false, parent_action))
+	return result
+
+func on_unit_spawned(unit: BaseCombatant) -> void:
+	_enqueue_unit_cells(unit, "spawn")
+
+func on_unit_action_started(unit: BaseCombatant) -> void:
+	_enqueue_unit_cells(unit, "stay")
+
+func _enqueue_unit_cells(unit: BaseCombatant, event: String) -> void:
+	if not active or board == null or not is_instance_valid(unit) or not unit.is_alive():
+		return
+	var actions: Array[BaseAction] = []
+	for cell: Vector2i in board.get_unit_cells(unit):
+		actions.append(FieldEventAction.new(self, event, cell, unit))
+	ActionHandler.add_ordered_actions(actions)
+
+## Single-board convenience wrapper; production uses one shared clock for all boards.
+func advance_ticks(previous_tick: int, current_tick: int) -> void:
+	if active and current_tick > previous_tick:
+		ActionHandler.add_ordered_actions([FieldClockAction.new([self], previous_tick, current_tick)])
+
+## Compatibility entry: collection no longer snapshots/consumes future boundaries.
+## Multiple boards must share a FieldClockAction, not concatenate these single-board clocks.
+func collect_tick_actions(previous_tick: int, current_tick: int) -> Array[Dictionary]:
+	if not active or board == null or current_tick <= previous_tick:
+		return []
+	return [{"tick": previous_tick, "order": 0, "action": FieldClockAction.new([self], previous_tick, current_tick)}]
+
+## Pure next-event query. A tick at the expiry boundary is excluded. Already consumed
+## boundaries are represented by next_tick, so equal-time events on other fields remain due.
+func next_tick_boundary(previous_tick: int, current_tick: int) -> Dictionary:
+	var best: Dictionary = {}
+	for instance: FieldInstance in _all_fields():
+		var tick: int = instance.next_tick
+		var interval: int = instance.field_data.field_tick_interval
+		if interval > 0 and tick >= 0:
+			if tick <= previous_tick:
+				tick += (int((previous_tick - tick) / interval) + 1) * interval
+			if tick <= current_tick and (instance.expires_tick < 0 or tick < instance.expires_tick):
+				if best.is_empty() or tick < best.tick:
+					best = {"tick": tick, "event": "tick", "instance": instance}
+		if instance.expires_tick >= 0 and instance.expires_tick <= current_tick:
+			if best.is_empty() or instance.expires_tick < best.tick:
+				best = {"tick": instance.expires_tick, "event": "expire", "instance": instance}
+	return best
+
+## Positive = danger, negative = healing/block benefit. Query does not move the unit.
+func preview_hazard(cell: Vector2i, unit: BaseCombatant) -> float:
+	if not active or board == null or not is_instance_valid(unit):
+		return 0.0
+	var total: float = 0.0
+	for covered: Vector2i in BoardData.footprint_cells(cell, unit.footprint):
+		for instance: FieldInstance in board.get_fields(covered):
+			if instance.affects(unit):
+				var data: FieldData = instance.field_data
+				total += instance.stacks * FieldPreview.preview_actions(data.field_on_enter_actions + data.field_on_stay_actions, instance.get_owner(), unit)
+	return total
+
+func clear() -> void:
+	generation += 1
+	active = false
+	for instance: FieldInstance in _all_fields():
+		remove_field(instance)
+	if board != null and board.field_controller != null and board.field_controller.get_ref() == self:
+		board.field_controller = null
+	_board_ref = null
+
+func _all_fields() -> Array[FieldInstance]:
+	var result: Array[FieldInstance] = []
+	if board != null:
+		for cell: Vector2i in board.fields:
+			result.append_array(board.get_fields(cell))
+	return result
diff --git a/scripts/combat/board/FieldEventAction.gd b/scripts/combat/board/FieldEventAction.gd
new file mode 100644
--- /dev/null
+++ b/scripts/combat/board/FieldEventAction.gd
@@ -0,0 +1,94 @@
+## Deferred field boundary. Resolves the living owner and occupancy at execution, and
+## puts child payloads ahead of the next movement/tick continuation.
+extends BaseAction
+class_name FieldEventAction
+
+var _controller_ref: WeakRef
+var _unit_ref: WeakRef
+var generation: int
+var event: String
+var cell: Vector2i
+var instance: FieldInstance
+var intermediate: bool
+var scheduled_revision: int = -1
+var scheduled_tick: int = -1
+var expected_board_id: String = ""
+var expected_anchor: Vector2i = BaseCombatant.BOARD_ANCHOR_NONE
+
+func _init(controller: FieldController, event_name: String, at_cell: Vector2i,
+		unit: BaseCombatant = null, field: FieldInstance = null,
+		passing: bool = false, ancestor: BaseAction = null) -> void:
+	_controller_ref = weakref(controller)
+	field_controller_ref = _controller_ref
+	field_controller_generation = controller.generation
+	_unit_ref = weakref(unit) if is_instance_valid(unit) else null
+	generation = controller.generation
+	event = event_name
+	cell = at_cell
+	instance = field
+	intermediate = passing
+	parent_action = ancestor
+	resolve_children_immediately = true
+	if ancestor != null:
+		field_effective_tick = ancestor.field_effective_tick
+	if is_instance_valid(unit) and event in ["enter", "leave"]:
+		expected_board_id = unit.board_id
+		expected_anchor = unit.board_anchor
+
+func perform_action() -> void:
+	var controller: FieldController = _controller_ref.get_ref()
+	if controller == null or not controller.active or generation != controller.generation or controller.board == null:
+		return
+	if instance != null and (not controller.has_field(instance) or (scheduled_revision >= 0 and scheduled_revision != instance.revision)):
+		return
+	if scheduled_tick >= 0:
+		field_effective_tick = scheduled_tick
+	if event == "expire":
+		controller.remove_field(instance)
+		return
+	var unit: BaseCombatant = _unit_ref.get_ref() if _unit_ref != null else controller.board.get_unit_at(cell)
+	if not is_instance_valid(unit) or not unit.is_alive():
+		return
+	if expected_anchor != BaseCombatant.BOARD_ANCHOR_NONE and (unit.board_id != expected_board_id or unit.board_anchor != expected_anchor):
+		return
+	# Cross-board transfer commits both endpoints before leave effects; only leave may
+	# legitimately refer to a cell the unit no longer occupies.
+	if event != "leave" and not intermediate and controller.board.get_unit_at(cell) != unit:
+		return
+	if event == "enter" or event == "spawn":
+		Signals.unit_entered_cell.emit(unit, controller.board.board_id, cell)
+	elif event == "leave":
+		Signals.unit_left_cell.emit(unit, controller.board.board_id, cell)
+	if generation != controller.generation or not controller.active:
+		return
+	if expected_anchor != BaseCombatant.BOARD_ANCHOR_NONE and (not is_instance_valid(unit) or unit.board_id != expected_board_id or unit.board_anchor != expected_anchor):
+		return
+	var fields: Array[FieldInstance] = []
+	if instance != null:
+		fields.append(instance)
+	else:
+		fields.assign(controller.board.get_fields(cell))
+	var actions: Array[BaseAction] = []
+	for field: FieldInstance in fields:
+		if not controller.has_field(field) or not field.affects(unit):
+			continue
+		var data: FieldData = field.field_data
+		if intermediate and not data.field_triggers_on_pass_through:
+			continue
+		if event == "spawn" and not data.field_triggers_on_spawn:
+			continue
+		var payload: Array[Dictionary] = []
+		match event:
+			"enter", "spawn": payload = data.field_on_enter_actions
+			"leave": payload = data.field_on_leave_actions
+			"stay": payload = data.field_on_stay_actions
+			"tick": payload = data.field_tick_actions
+		if payload.is_empty():
+			continue
+		controller.board.invalidate_undo(unit)
+		for stack: int in field.stacks:
+			for child: BaseAction in ActionGenerator.create_actions(field.get_owner(), null, [unit], payload, self):
+				child.field_owner_bound = true
+				child.field_owner_uid = field.owner_uid
+				actions.append(child)
+	ActionHandler.add_ordered_actions(actions)
diff --git a/scripts/combat/board/FieldInstance.gd b/scripts/combat/board/FieldInstance.gd
new file mode 100644
--- /dev/null
+++ b/scripts/combat/board/FieldInstance.gd
@@ -0,0 +1,52 @@
+## One live field on one cell. No strong reference to its creator or board.
+extends RefCounted
+class_name FieldInstance
+
+var field_data: FieldData = null
+var cell: Vector2i = Vector2i.ZERO
+var board_id: String = ""
+var owner_uid: String = ""
+## Kept after the creator dies; relative faction filters must not change allegiance.
+var owner_faction: int = -1
+var created_tick: int = 0
+var expires_tick: int = -1
+var next_tick: int = -1
+var stacks: int = 1
+## Refresh can occur twice at one combat tick; a timestamp is not a version.
+var revision: int = 0
+
+func _init(data: FieldData = null, at_cell: Vector2i = Vector2i.ZERO,
+		owner: BaseCombatant = null, tick: int = 0, duration_override: int = -2) -> void:
+	field_data = data
+	cell = at_cell
+	if is_instance_valid(owner):
+		owner_uid = owner.unit_uid
+		owner_faction = owner.faction
+	refresh(tick, duration_override)
+
+func refresh(tick: int, duration_override: int = -2) -> void:
+	revision += 1
+	created_tick = tick
+	var duration: int = duration_override if duration_override != -2 else field_data.field_duration_ticks
+	expires_tick = tick + max(0, duration) if duration >= 0 else -1
+	next_tick = tick + field_data.field_tick_interval if field_data.field_tick_interval > 0 else -1
+
+func get_owner() -> BaseCombatant:
+	var owner: BaseCombatant = UnitRegistry.get_unit(owner_uid)
+	return owner if is_instance_valid(owner) and owner.is_alive() else null
+
+func affects(unit: BaseCombatant) -> bool:
+	if not is_instance_valid(unit) or not unit.is_alive():
+		return false
+	match field_data.field_faction_filter:
+		FieldData.FACTION_FILTERS.ANY:
+			return true
+		FieldData.FACTION_FILTERS.PARTY:
+			return unit.faction == BaseCombatant.FACTIONS.PARTY
+		FieldData.FACTION_FILTERS.ENEMY:
+			return unit.faction == BaseCombatant.FACTIONS.ENEMY
+		FieldData.FACTION_FILTERS.ALLY_OF_OWNER:
+			return owner_faction >= 0 and unit.faction == owner_faction
+		FieldData.FACTION_FILTERS.OPPONENT_OF_OWNER:
+			return owner_faction >= 0 and unit.faction != owner_faction and unit.faction != BaseCombatant.FACTIONS.NEUTRAL
+	return false
diff --git a/scripts/combat/board/FieldPreview.gd b/scripts/combat/board/FieldPreview.gd
new file mode 100644
--- /dev/null
+++ b/scripts/combat/board/FieldPreview.gd
@@ -0,0 +1,75 @@
+## Read-only numeric preview of standard field/opportunity payloads. Unknown actions contribute
+## zero; random damage uses its mean without drawing RNG. No action is performed here.
+extends RefCounted
+class_name FieldPreview
+
+static func preview_actions(payload: Array[Dictionary], owner: BaseCombatant,
+		unit: BaseCombatant, account_block: bool = false, include_benefits: bool = true) -> float:
+	if not is_instance_valid(unit) or not unit.is_alive():
+		return 0.0
+	var state: Dictionary = {"total": 0.0, "block": float(unit.get_block())}
+	preview_actions_into(payload, owner, unit, state, account_block, include_benefits)
+	return state.total
+
+## Shared simulated block pool for consecutive opportunity controllers; callers own
+## state={total:0.0, block:unit.get_block()}, which is never written into a combatant.
+static func preview_actions_into(payload: Array[Dictionary], owner: BaseCombatant,
+		unit: BaseCombatant, state: Dictionary, account_block: bool = false, include_benefits: bool = true) -> void:
+	if not is_instance_valid(unit) or not unit.is_alive():
+		return
+	for action: BaseAction in ActionGenerator.create_actions(owner, null, [unit], payload, null):
+		var path: String = action.get_script().resource_path
+		if path == Scripts.ACTION_ATTACK_GENERATOR:
+			_preview_generator(action, unit, state, account_block)
+		else:
+			_preview_direct(action, unit, state, account_block, include_benefits)
+
+static func _targets_unit(action: BaseAction, unit: BaseCombatant) -> bool:
+	var override: int = int(action.get_action_value("target_override", BaseAction.TARGET_OVERRIDES.SELECTED_TARGETS))
+	# Random target selection must never advance the named target RNG during preview.
+	if override == BaseAction.TARGET_OVERRIDES.RANDOM_ENEMY or override == BaseAction.TARGET_OVERRIDES.RANDOM_OPPONENT:
+		return false
+	return action.get_adjusted_action_targets().has(unit)
+
+static func _preview_generator(action: BaseAction, unit: BaseCombatant, state: Dictionary, account_block: bool) -> void:
+	for processor: ActionInterceptorProcessor in action._intercept_action([], true):
+		var damage: float = float(processor.get_shadowed_action_values("damage", 0))
+		var random_damage: int = int(processor.get_shadowed_action_values("damage_random", 0))
+		if random_damage > 1:
+			damage += random_damage / 2.0
+		var count: int = max(0, int(processor.get_shadowed_action_values("number_of_attacks", 1)))
+		if bool(processor.get_shadowed_action_values("merge_attacks", false)):
+			damage *= count
+			count = 1
+		var child_values: Dictionary[String, Variant] = {
+			"damage": damage,
+			"target_override": processor.get_shadowed_action_values("target_override", BaseAction.TARGET_OVERRIDES.SELECTED_TARGETS),
+		}
+		for index: int in count:
+			var child: BaseAction = load(Scripts.ACTION_ATTACK).new()
+			child.init(action.parent_combatant, null, [unit], child_values, action)
+			_preview_direct(child, unit, state, account_block, false)
+
+static func _preview_direct(action: BaseAction, unit: BaseCombatant, state: Dictionary,
+		account_block: bool, include_benefits: bool) -> void:
+	var path: String = action.get_script().resource_path
+	if not [Scripts.ACTION_ATTACK, Scripts.ACTION_DIRECT_DAMAGE, Scripts.ACTION_BLOCK,
+			Scripts.ACTION_ADD_HEALTH, Scripts.ACTION_HEAL_PERCENT].has(path) or not _targets_unit(action, unit):
+		return
+	for processor: ActionInterceptorProcessor in action._intercept_action([unit], true):
+		if path == Scripts.ACTION_ATTACK or path == Scripts.ACTION_DIRECT_DAMAGE:
+			var damage: float = maxf(0.0, float(processor.get_shadowed_action_values("damage", 0)))
+			if account_block and not bool(processor.get_shadowed_action_values("bypass_block", false)):
+				var absorbed: float = minf(state.block, damage)
+				state.block -= absorbed
+				damage -= absorbed
+			state.total += damage
+		elif path == Scripts.ACTION_BLOCK:
+			var block: float = maxf(0.0, float(processor.get_shadowed_action_values("block", 0)))
+			state.block += block
+			if include_benefits:
+				state.total -= block
+		elif include_benefits and path == Scripts.ACTION_ADD_HEALTH:
+			state.total -= float(processor.get_shadowed_action_values("health_amount", 0))
+		elif include_benefits and path == Scripts.ACTION_HEAL_PERCENT:
+			state.total -= floorf(unit.get_combatant_health_max() * float(processor.get_shadowed_action_values("percentage_heal_amount", 1.0)))
diff --git a/scripts/combat/board/IntentTeleportResolver.gd b/scripts/combat/board/IntentTeleportResolver.gd
new file mode 100644
--- /dev/null
+++ b/scripts/combat/board/IntentTeleportResolver.gd
@@ -0,0 +1,36 @@
+## Teleport choice is a pure query. RANDOM_EMPTY uses a stable intent/action seed so repainting
+## previews cannot advance gameplay RNG or change the announced landing cell.
+extends RefCounted
+class_name IntentTeleportResolver
+
+static func choose(board: BoardData, enemy: BaseCombatant, intent: EnemyIntentData, target: BaseCombatant) -> Vector2i:
+	var candidates: Array[Vector2i] = []
+	var rule: int = intent.enemy_intent_teleport_rule
+	for cell: Vector2i in board.all_cells():
+		if cell == enemy.board_anchor or not board.can_teleport(enemy, cell):
+			continue
+		if rule == EnemyIntentData.TELEPORT_RULES.ADJACENT_TO_TARGET and (not board.has_unit(target) or board.unit_distance(enemy, target, cell) != 1):
+			continue
+		if rule == EnemyIntentData.TELEPORT_RULES.MARKED_CELL:
+			if intent.enemy_intent_marked_cell != BaseCombatant.BOARD_ANCHOR_NONE:
+				if cell != intent.enemy_intent_marked_cell:
+					continue
+			elif intent.enemy_intent_marked_field_tag == "" or board.get_fields(cell, intent.enemy_intent_marked_field_tag).is_empty():
+				continue
+		candidates.append(cell)
+	if candidates.is_empty():
+		return enemy.board_anchor
+	if rule == EnemyIntentData.TELEPORT_RULES.RANDOM_EMPTY:
+		var seed_text: String = "%s:%s:%s" % [enemy.unit_uid, intent.object_id, enemy.next_action_tick]
+		return candidates[posmod(seed_text.hash(), candidates.size())]
+	var best: Vector2i = candidates[0]
+	var best_key: int = -1
+	for cell: Vector2i in candidates:
+		var score: int = 0
+		if rule == EnemyIntentData.TELEPORT_RULES.FARTHEST_FROM_OPPONENTS:
+			score = 500 - mini(499, IntentResolver._nearest_opponent_distance(board, enemy, cell))
+		var key: int = BoardData.sort_key([score, cell.y, cell.x])
+		if best_key < 0 or key < best_key:
+			best = cell
+			best_key = key
+	return best
diff --git a/scripts/ui/BoardActorPresentation.gd b/scripts/ui/BoardActorPresentation.gd
new file mode 100644
--- /dev/null
+++ b/scripts/ui/BoardActorPresentation.gd
@@ -0,0 +1,215 @@
+## Owns only presentation transforms. The unit, HUD, animation paths and registry identity stay
+## together under their original parent; interpolated positions never become gameplay coordinates.
+extends Node
+class_name BoardActorPresentation
+
+const MOVE_SECONDS: float = 0.16
+var views: Dictionary[String, BoardView] = {}
+var _actors: Dictionary = {}
+var _tweens: Dictionary = {}
+var _retired: Dictionary = {}
+
+func _ready() -> void:
+	Signals.unit_board_moved.connect(_on_position_committed)
+	Signals.enemy_killed.connect(_on_actor_killed)
+	Signals.player_killed.connect(_on_actor_killed)
+	Signals.run_ended.connect(_on_display_ended)
+	Signals.combat_ended.connect(_on_display_ended)
+
+func _on_position_committed(_unit: BaseCombatant, _from_id: StringName, _from: Vector2i, _to_id: StringName, _to: Vector2i) -> void:
+	# Geometry is committed before leave/enter effects. Capture its visual destination now,
+	# including both sides of a swap, before a synchronous lethal reaction can remove a unit.
+	get_parent().sync_board_views()
+	sync_positions(true)
+
+func _on_actor_killed(unit: BaseCombatant) -> void:
+	if is_instance_valid(unit) and _actors.has(unit.unit_uid):
+		_stop_tween(unit.unit_uid)
+		unit.global_position = _actors[unit.unit_uid]["target"]
+
+func _process(_delta: float) -> void:
+	sync_positions(true)
+
+func target_position_for(unit: BaseCombatant) -> Vector2:
+	var view: BoardView = views.get(unit.board_id)
+	if view == null:
+		return unit.global_position
+	var state: Dictionary = _actors.get(unit.unit_uid, {})
+	var foot: Vector2 = state["foot"] if state.has("foot") else _standing_foot(unit)
+	return view.unit_footpoint(unit) - foot * unit.scale
+
+func _standing_foot(unit: BaseCombatant) -> Vector2:
+	var sprite: AnimatedSprite2D = unit.animated_sprite_2d
+	var rest_offset: Vector2 = unit.presentation_sprite_offset if unit.presentation_sprite_origin_captured else sprite.offset
+	var foot: Vector2 = _authored_sprite_origin(unit) + rest_offset
+	var frames: SpriteFrames = sprite.sprite_frames
+	if frames != null:
+		var animation: StringName = &"idle" if frames.has_animation(&"idle") else sprite.animation
+		if frames.has_animation(animation) and frames.get_frame_count(animation) > 0:
+			var texture: Texture2D = frames.get_frame_texture(animation, 0)
+			if texture != null:
+				foot.y += texture.get_height() * (0.5 if sprite.centered else 1.0)
+	return foot
+
+## Run-start and attack animations can already be offset when combat begins. Use the scene's
+## authored standing origin instead of freezing an in-flight animation position into the mapping.
+func _authored_sprite_origin(unit: BaseCombatant) -> Vector2:
+	if unit.presentation_sprite_origin_captured:
+		return unit.presentation_sprite_origin
+	if unit.scene_file_path != "":
+		var scene: PackedScene = load(unit.scene_file_path) as PackedScene
+		if scene != null:
+			var scene_state: SceneState = scene.get_state()
+			var path: NodePath = unit.get_path_to(unit.animated_sprite_2d)
+			for index: int in scene_state.get_node_count():
+				if str(scene_state.get_node_path(index)).trim_prefix("./") != str(path).trim_prefix("./"):
+					continue
+				for property: int in scene_state.get_node_property_count(index):
+					if scene_state.get_node_property_name(index, property) == &"position":
+						return scene_state.get_node_property_value(index, property)
+	return unit.animated_sprite_2d.position
+
+func sync_positions(animate: bool = false) -> void:
+	var director: CombatDirector = Global.get_combat_director()
+	if director == null or not director.is_running or director.battlefield == null:
+		clear()
+		return
+	var present: Dictionary = {}
+	for unit: BaseCombatant in director.battlefield.get_units():
+		if not is_instance_valid(unit) or not unit.is_inside_tree():
+			continue
+		var view: BoardView = views.get(unit.board_id)
+		if view == null:
+			continue
+		present[unit.unit_uid] = true
+		var first: bool = not _actors.has(unit.unit_uid)
+		if first:
+			_capture(unit)
+		unit.scale = Vector2.ONE * minf(0.65, view.cell_size / 128.0)
+		var target: Vector2 = target_position_for(unit)
+		# Each actor owns its complete sprite/HUD/hitbox subtree. Feet provide stable depth order.
+		unit.z_index = 1 + clampi(int(7.0 * (unit.board_anchor.y + unit.footprint.y) / view.get_board().size.y), 0, 7)
+		var state: Dictionary = _actors[unit.unit_uid]
+		unit.selection_button.tooltip_text = view.field_tooltip(unit.board_anchor)
+		var marker: Label = state.get("mode_marker")
+		if marker != null:
+			marker.text = movement_mode_label(unit as Enemy)
+			marker.visible = marker.text != ""
+		if first or not animate or not (state["target"] as Vector2).is_equal_approx(target):
+			_stop_tween(unit.unit_uid)
+			state["target"] = target
+			if animate and not first:
+				var tween: Tween = create_tween()
+				_tweens[unit.unit_uid] = tween
+				tween.tween_property(unit, "global_position", target, MOVE_SECONDS)
+			else:
+				unit.global_position = target
+	for uid: String in _actors.keys():
+		if not present.has(uid):
+			_release(uid)
+
+func _capture(unit: BaseCombatant) -> void:
+	var button: Button = unit.selection_button
+	var original: Callable = Callable(unit, "_on_selection_button_up")
+	var had_original: bool = button.button_up.is_connected(original)
+	if had_original:
+		button.button_up.disconnect(original)
+	var click: Callable = _on_actor_clicked.bind(unit)
+	var hover: Callable = _on_actor_hovered.bind(unit)
+	button.button_up.connect(click)
+	button.mouse_entered.connect(hover)
+	_actors[unit.unit_uid] = {
+		"unit": unit, "position": unit.position, "scale": unit.scale, "z": unit.z_index,
+		"filter": unit.mouse_filter, "click": click, "hover": hover,
+		"original": original, "had_original": had_original, "target": unit.global_position,
+		"foot": _standing_foot(unit), "tooltip": button.tooltip_text,
+	}
+	unit.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	if unit is Enemy:
+		var marker := Label.new()
+		marker.name = "MovementMode"
+		marker.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		(unit as Enemy).enemy_intent.add_child(marker)
+		_actors[unit.unit_uid]["mode_marker"] = marker
+
+func _on_actor_clicked(unit: BaseCombatant) -> void:
+	# One accepted click emits one board event, never both board and legacy enemy click events.
+	if is_instance_valid(unit) and unit.is_alive():
+		Signals.board_cell_clicked.emit(unit.board_id, unit.board_anchor)
+
+func _on_actor_hovered(unit: BaseCombatant) -> void:
+	if is_instance_valid(unit) and unit.is_alive():
+		Signals.board_cell_hovered.emit(unit.board_id, unit.board_anchor)
+
+func _stop_tween(uid: String) -> void:
+	var tween: Tween = _tweens.get(uid)
+	if tween != null and tween.is_valid():
+		tween.kill()
+	_tweens.erase(uid)
+
+func _release(uid: String) -> void:
+	_stop_tween(uid)
+	var state: Dictionary = _actors[uid]
+	var unit: Variant = state["unit"]
+	var marker: Variant = state.get("mode_marker")
+	if is_instance_valid(marker):
+		marker.queue_free()
+	if is_instance_valid(unit):
+		var button: Button = unit.selection_button
+		if is_instance_valid(button):
+			button.tooltip_text = state["tooltip"]
+			if button.button_up.is_connected(state["click"]):
+				button.button_up.disconnect(state["click"])
+			if button.mouse_entered.is_connected(state["hover"]):
+				button.mouse_entered.disconnect(state["hover"])
+			if state["had_original"] and not button.button_up.is_connected(state["original"]):
+				button.button_up.connect(state["original"])
+		# A dying actor keeps its last board position until its existing death animation frees it.
+		if unit.is_alive():
+			unit.position = state["position"]
+			unit.scale = state["scale"]
+			unit.z_index = state["z"]
+		else:
+			_retired[uid] = state
+		unit.mouse_filter = state["filter"]
+	_actors.erase(uid)
+
+func clear() -> void:
+	for uid: String in _actors.keys():
+		_release(uid)
+
+func _on_display_ended() -> void:
+	clear()
+	# The hero node survives run changes. Keep its death pose through the animation, then
+	# restore the pre-combat transform before the same node can represent a new run.
+	for state: Dictionary in _retired.values():
+		var unit: Variant = state["unit"]
+		if is_instance_valid(unit):
+			unit.position = state["position"]
+			unit.scale = state["scale"]
+			unit.z_index = state["z"]
+	_retired.clear()
+
+func _exit_tree() -> void:
+	if Signals.unit_board_moved.is_connected(_on_position_committed):
+		Signals.unit_board_moved.disconnect(_on_position_committed)
+	if Signals.enemy_killed.is_connected(_on_actor_killed):
+		Signals.enemy_killed.disconnect(_on_actor_killed)
+	if Signals.player_killed.is_connected(_on_actor_killed):
+		Signals.player_killed.disconnect(_on_actor_killed)
+	if Signals.run_ended.is_connected(_on_display_ended):
+		Signals.run_ended.disconnect(_on_display_ended)
+	if Signals.combat_ended.is_connected(_on_display_ended):
+		Signals.combat_ended.disconnect(_on_display_ended)
+	_on_display_ended()
+	views.clear()
+
+## Text fallbacks keep movement intentions legible without requiring content-specific art.
+static func movement_mode_label(enemy: Enemy) -> String:
+	if enemy == null or enemy.enemy_data == null:
+		return ""
+	var intent: EnemyIntentData = enemy.enemy_data.get_current_intent()
+	if intent == null:
+		return ""
+	var labels: Array[String] = ["", "->", "<-", "<->", "FLANK", "CHARGE", "TP"]
+	return labels[intent.enemy_intent_move] if intent.enemy_intent_move >= 0 and intent.enemy_intent_move < labels.size() else "?"
diff --git a/scripts/validators/board/ValidatorAdjacentUnits.gd b/scripts/validators/board/ValidatorAdjacentUnits.gd
new file mode 100644
--- /dev/null
+++ b/scripts/validators/board/ValidatorAdjacentUnits.gd
@@ -0,0 +1,12 @@
+## Counts living adjacent units once per footprint; faction is relative to around.
+extends BaseValidator
+
+func _validation(_card_data: CardData, action: BaseAction, values: Dictionary[String, Variant]) -> bool:
+	var parent: BaseCombatant = BoardTargeting.context_parent(action)
+	var board: BoardData = BoardData.get_for_unit(parent)
+	var around: BaseCombatant = BoardTargeting.context_unit(board, action, parent, str(_get_validator_value("around", values, action, "PARENT")))
+	board = BoardData.get_for_unit(around)
+	if board == null or around == null:
+		return true
+	var count: int = BoardPositionQueries.count_adjacent(board, around, str(_get_validator_value("faction", values, action, "ANY")))
+	return _compare(count, int(_get_validator_value("comparison_value", values, action, 1)), str(_get_validator_value("operator", values, action, ">=")))
diff --git a/scripts/validators/board/ValidatorCellHasField.gd b/scripts/validators/board/ValidatorCellHasField.gd
new file mode 100644
--- /dev/null
+++ b/scripts/validators/board/ValidatorCellHasField.gd
@@ -0,0 +1,29 @@
+## Checks an explicit cell, SELECTED_CELL (default), or PARENT_CELL. Both field_id and tag
+## constrain the same instance. BaseValidator also supports the standard invert_validation.
+extends BaseValidator
+class_name ValidatorCellHasField
+
+func _validation(_card_data: CardData, action: BaseAction, values: Dictionary[String, Variant]) -> bool:
+	var board: BoardData = null
+	if action != null:
+		board = FieldActionCells.resolve_board(action, _get_validator_value("board_id", values, action, null))
+	else:
+		var battlefield: CombatBattlefield = CombatBattlefield.get_active()
+		if battlefield != null:
+			board = battlefield.get_board(str(values.board_id)) if values.has("board_id") else battlefield.get_board_for_unit(BoardTargeting.context_parent(null))
+	if board == null:
+		return false
+	var value: Variant = _get_validator_value("cell", values, action, "SELECTED_CELL")
+	var cell: Vector2i = BoardTargeting.context_cell(action, value)
+	if value is String and value == "PARENT_CELL":
+		var parent: BaseCombatant = BoardTargeting.context_parent(action)
+		if is_instance_valid(parent) and board.has_unit(parent):
+			cell = parent.board_anchor
+	var field_id: String = str(_get_validator_value("field_id", values, action, ""))
+	var tag: String = str(_get_validator_value("tag", values, action, ""))
+	var found: bool = false
+	for instance: FieldInstance in board.get_fields(cell, tag):
+		if field_id == "" or instance.field_data.object_id == field_id:
+			found = true
+			break
+	return found != bool(values.get("invert", false))
diff --git a/scripts/validators/board/ValidatorFlanked.gd b/scripts/validators/board/ValidatorFlanked.gd
new file mode 100644
--- /dev/null
+++ b/scripts/validators/board/ValidatorFlanked.gd
@@ -0,0 +1,16 @@
+## PINCER: parent and ally on opposing cardinal sides. SURROUND: target's adjacent opponents.
+extends BaseValidator
+
+func _validation(_card_data: CardData, action: BaseAction, values: Dictionary[String, Variant]) -> bool:
+	var parent: BaseCombatant = BoardTargeting.context_parent(action)
+	var board: BoardData = BoardData.get_for_unit(parent)
+	var target: BaseCombatant = BoardTargeting.context_unit(board, action, parent, str(_get_validator_value("target", values, action, "SELECTED_TARGET")))
+	if board == null or target == null:
+		return true
+	var target_board: BoardData = BoardData.get_for_unit(target)
+	var query: Dictionary = BoardTargeting.geometry(target_board, parent, target.board_anchor, BoardTargeting.TARGET_SHAPES.SINGLE)
+	if not query.valid:
+		return false
+	if str(_get_validator_value("mode", values, action, "PINCER")) == "SURROUND":
+		return BoardPositionQueries.surrounded_count(target_board, target) >= int(_get_validator_value("comparison_value", values, action, 2))
+	return not query.cross_board and BoardPositionQueries.is_flanked(board, parent, target)
diff --git a/scripts/validators/board/ValidatorOnEdge.gd b/scripts/validators/board/ValidatorOnEdge.gd
