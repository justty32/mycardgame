+
+@export var field_name: String = ""
+@export var field_color_id: String = ""
+@export var field_icon_texture_path: String = ""
+@export var field_duration_ticks: int = -1
+@export var field_tick_interval: int = 0
+@export var field_faction_filter: int = FACTION_FILTERS.ANY
+@export var field_stack_policy: int = STACK_POLICIES.REPLACE
+@export var field_blocks_movement: bool = false
+@export var field_blocks_teleport_into: bool = false
+@export var field_move_cost_override: int = -1
+@export var field_triggers_on_pass_through: bool = false
+@export var field_triggers_on_spawn: bool = false
+@export var field_on_enter_actions: Array[Dictionary] = []
+@export var field_on_leave_actions: Array[Dictionary] = []
+@export var field_on_stay_actions: Array[Dictionary] = []
+@export var field_tick_actions: Array[Dictionary] = []
+@export var field_tags: Array[String] = []
diff --git a/scripts/actions/board_actions/ActionCreateField.gd b/scripts/actions/board_actions/ActionCreateField.gd
new file mode 100644
--- /dev/null
+++ b/scripts/actions/board_actions/ActionCreateField.gd
@@ -0,0 +1,23 @@
+## Creates a field on explicit cells, SELECTED_CELL/PARENT_CELL, or the card's shape.
+## duration_override=-2 uses the template, -1 is permanent. owner="NONE" creates no owner.
+extends BaseAction
+class_name ActionCreateField
+
+func perform_action() -> void:
+	for processor: ActionInterceptorProcessor in _intercept_action([]):
+		var cell_value: Variant = processor.get_shadowed_action_values("cells", null)
+		var board: BoardData = FieldActionCells.resolve_effect_board(self, processor.get_shadowed_action_values("board_id", null), cell_value)
+		var controller: FieldController = FieldController.for_board(board)
+		if controller == null:
+			continue
+		var data: FieldData = Global.get_field_data(str(processor.get_shadowed_action_values("field_id", "")))
+		if data == null:
+			continue
+		var cells: Array[Vector2i] = FieldActionCells.resolve(self, controller.board, cell_value, true)
+		var owner: BaseCombatant = parent_combatant if str(processor.get_shadowed_action_values("owner", "PARENT")) == "PARENT" else null
+		var director: CombatDirector = Global.get_combat_director()
+		var tick: int = director.current_tick if director != null else 0
+		if field_effective_tick >= 0:
+			tick = field_effective_tick
+		for cell: Vector2i in cells:
+			controller.create_field(data, cell, owner, tick, int(processor.get_shadowed_action_values("duration_override", -2)))
diff --git a/scripts/actions/board_actions/ActionRemoveField.gd b/scripts/actions/board_actions/ActionRemoveField.gd
new file mode 100644
--- /dev/null
+++ b/scripts/actions/board_actions/ActionRemoveField.gd
@@ -0,0 +1,16 @@
+## Removes matching field_id/tag on cells; omitted cells means the entire selected board.
+extends BaseAction
+class_name ActionRemoveField
+
+func perform_action() -> void:
+	for processor: ActionInterceptorProcessor in _intercept_action([]):
+		var board: BoardData = FieldActionCells.resolve_board(self, processor.get_shadowed_action_values("board_id", null))
+		var controller: FieldController = FieldController.for_board(board)
+		if controller == null:
+			continue
+		var value: Variant = processor.get_shadowed_action_values("cells", null)
+		var cells: Array[Vector2i] = FieldActionCells.resolve(self, controller.board, value)
+		# Explicit empty/invalid cells never accidentally mean remove from the whole board.
+		if value != null and cells.is_empty():
+			continue
+		controller.remove_fields(cells, str(processor.get_shadowed_action_values("field_id", "")), str(processor.get_shadowed_action_values("tag", "")))
diff --git a/scripts/actions/board_actions/ActionSetCellBlocked.gd b/scripts/actions/board_actions/ActionSetCellBlocked.gd
new file mode 100644
--- /dev/null
+++ b/scripts/actions/board_actions/ActionSetCellBlocked.gd
@@ -0,0 +1,20 @@
+## Creates/destroys static obstacle flags. Occupied cells cannot become obstacles.
+extends BaseAction
+class_name ActionSetCellBlocked
+
+func perform_action() -> void:
+	for processor: ActionInterceptorProcessor in _intercept_action([]):
+		var cell_value: Variant = processor.get_shadowed_action_values("cells", null)
+		var board: BoardData = FieldActionCells.resolve_effect_board(self, processor.get_shadowed_action_values("board_id", null), cell_value)
+		if board == null:
+			continue
+		var blocked: bool = bool(processor.get_shadowed_action_values("blocked", true))
+		var changed: bool = false
+		for cell: Vector2i in FieldActionCells.resolve(self, board, cell_value, true):
+			if blocked and board.get_unit_at(cell) != null:
+				continue
+			if board.is_blocked(cell) != blocked:
+				board.set_blocked(cell, blocked)
+				changed = true
+		if changed:
+			Signals.board_changed.emit(board.board_id)
diff --git a/scripts/actions/board_actions/BoardMoveSequence.gd b/scripts/actions/board_actions/BoardMoveSequence.gd
new file mode 100644
--- /dev/null
+++ b/scripts/actions/board_actions/BoardMoveSequence.gd
@@ -0,0 +1,164 @@
+## Ordered movement continuation. Each child effect resolves before the next step.
+## No coroutine or retained board/controller cycle survives ActionHandler.clear_all_actions().
+extends BaseAction
+class_name BoardMoveSequence
+
+var state: Dictionary = {}
+var stage: int = 0
+
+static func start(board: BoardData, unit: BaseCombatant, path: Array[Vector2i], source: BaseAction, options: Dictionary) -> void:
+	var action: BoardMoveSequence = BoardMoveSequence.new()
+	action.inherit_execution_context(source)
+	action.state = {"board": weakref(board), "unit": weakref(unit), "path": path, "source": source, "options": options,
+		"index": 0, "from": unit.board_anchor, "cursor": unit.board_anchor, "moved": 0, "cost": 0, "collided": false, "expected_anchor": unit.board_anchor, "expected_board": unit.board_id, "generation": ActionHandler._action_generation, "crossed": {}, "finished": false, "director_running": _running_director()}
+	action.perform_action()
+
+func perform_action() -> void:
+	if not state.source.prepare_execution() or not prepare_execution():
+		return
+	var board: BoardData = state.board.get_ref()
+	var unit: BaseCombatant = state.unit.get_ref()
+	if not _valid(board, unit):
+		_finish(board, unit)
+		return
+	while state.index < state.path.size():
+		if not _valid(board, unit):
+			_finish(board, unit)
+			return
+		var from: Vector2i = state.cursor
+		var to: Vector2i = state.path[state.index]
+		var options: Dictionary = state.options
+		var last: bool = state.index == state.path.size() - 1
+		if stage == 0:
+			var allowed: bool = board.can_teleport(unit, to) if options.get("teleport", false) else (board.can_stand(unit, to) if last or options.get("forced", false) or (options.get("charge", false) and not unit.ignores_occupancy) else board.can_pass(unit, to))
+			if not allowed:
+				_collision(board, unit, to)
+				_finish(board, unit)
+				return
+			var step: int = board.step_cost(unit, from, to, options.get("ignore_zoc", false))
+			if options.get("consumes", false) and unit.move_points < step and unit.paid_cells_this_action >= board.rules.paid_move_max_cells:
+				_finish(board, unit)
+				return
+			state.step_cost = step
+			stage = 1
+			var before: Array[BaseAction] = board.movement_state.opportunity_actions(board, unit, from, options.get("ignore_zoc", false), options.get("forced", false), state.source)
+			before.append_array(_field_actions(board, unit, from, to, false, state.index > 0))
+			if _suspend(before):
+				return
+		if stage == 1:
+			# The previous field or opportunity action may have killed, moved or blocked us.
+			if not _valid(board, unit):
+				_finish(board, unit)
+				return
+			state.step_cost = board.step_cost(unit, from, to, options.get("ignore_zoc", false))
+			if options.get("consumes", false) and unit.move_points < state.step_cost and unit.paid_cells_this_action >= board.rules.paid_move_max_cells:
+				_finish(board, unit)
+				return
+			if options.get("teleport", false) and not board.can_teleport(unit, to):
+				_finish(board, unit)
+				return
+			var did_place: bool = false
+			if board.can_stand(unit, to):
+				did_place = true
+				board.move(unit, to)
+				state.expected_anchor = unit.board_anchor
+			elif last or options.get("forced", false) or (options.get("charge", false) and not unit.ignores_occupancy) or not board.can_pass(unit, to):
+				_finish(board, unit)
+				return
+			state.cursor = to
+			var moved_now: int = board.distance(from, to) if options.get("teleport", false) else 1
+			state.moved += moved_now
+			var source: BaseAction = state.source
+			if source.card_play_request != null:
+				var counter_key: String = "displaced_cells" if options.get("forced", false) else "moved_cells"
+				source.card_play_request.card_values[counter_key] = int(source.card_play_request.card_values.get(counter_key, 0)) + moved_now
+			state.cost += state.step_cost
+			if options.get("forced", false):
+				unit.cells_displaced_this_action += board.distance(from, to) if options.get("teleport", false) else 1
+			else:
+				unit.cells_moved_this_action += board.distance(from, to) if options.get("teleport", false) else 1
+			var paid: bool = false
+			if options.get("consumes", false):
+				paid = unit.move_points < state.step_cost
+				unit.move_points = max(0, unit.move_points - int(state.step_cost))
+				if paid:
+					unit.paid_cells_this_action += 1
+					unit.action_extra_delay += board.rules.extra_move_delay_per_cell
+			if did_place:
+				Signals.unit_board_moved.emit(unit, board.board_id, from, board.board_id, to)
+			if paid and _valid(board, unit):
+				Signals.timeline_changed.emit()
+			if not _valid(board, unit):
+				_finish(board, unit)
+				return
+			stage = 2
+			var after: Array[BaseAction] = _field_actions(board, unit, from, to, true, not last)
+			var path_actions: Array[Dictionary] = []
+			path_actions.assign(options.get("path_actions", []))
+			if not path_actions.is_empty() and unit.ignores_occupancy:
+				var crossed: Array[BaseCombatant] = board.units_in_cells(BoardData.footprint_cells(to, unit.footprint))
+				crossed.erase(unit)
+				var unique_crossed: Array[BaseCombatant] = []
+				for crossed_unit: BaseCombatant in crossed:
+					if not state.crossed.has(crossed_unit.unit_uid):
+						state.crossed[crossed_unit.unit_uid] = true
+						unique_crossed.append(crossed_unit)
+				crossed = unique_crossed
+				if not crossed.is_empty():
+					board.invalidate_undo(unit)
+					after.append_array(ActionGenerator.create_actions(unit, state.source.card_play_request, crossed, path_actions, state.source))
+			if _suspend(after):
+				return
+		state.index += 1
+		stage = 0
+	_finish(board, unit)
+
+func _field_actions(board: BoardData, unit: BaseCombatant, from: Vector2i, to: Vector2i, entering: bool, intermediate: bool) -> Array[BaseAction]:
+	if board.field_controller == null or board.field_controller.get_ref() == null:
+		return []
+	return board.field_controller.get_ref().make_movement_actions(unit, from, to, entering, intermediate, state.source)
+
+func _suspend(actions: Array[BaseAction]) -> bool:
+	if not _valid(state.board.get_ref(), state.unit.get_ref()):
+		return true
+	if actions.is_empty():
+		return false
+	var continuation: BoardMoveSequence = BoardMoveSequence.new()
+	continuation.inherit_execution_context(state.source)
+	continuation.state = state
+	continuation.stage = stage
+	actions.append(continuation)
+	ActionHandler.add_ordered_actions(actions)
+	return true
+
+func _collision(board: BoardData, unit: BaseCombatant, to: Vector2i) -> void:
+	if not state.options.get("forced", false) or state.options.get("teleport", false):
+		return
+	state.collided = true
+	if state.source.card_play_request != null:
+		state.source.card_play_request.card_values["collided"] = true
+	var blocker: BaseCombatant = null
+	for cell: Vector2i in BoardData.footprint_cells(to, unit.footprint):
+		var occupant: BaseCombatant = board.get_unit_at(cell)
+		if occupant != null and occupant != unit:
+			blocker = occupant
+			break
+	state.source._apply_collision(state.options.processor, unit, blocker, state.path.size() - state.index)
+
+func _finish(board: BoardData, unit: BaseCombatant) -> void:
+	if state.finished:
+		return
+	state.finished = true
+	if state.moved > 0 and _valid(board, unit):
+		Signals.unit_moved.emit(unit, state.from, unit.board_anchor)
+
+static func _running_director() -> bool:
+	var director: CombatDirector = Global.get_combat_director()
+	return director != null and director.is_running
+
+func _valid(board: BoardData, unit: BaseCombatant) -> bool:
+	if board == null or not is_instance_valid(unit) or not unit.is_alive() or not board.has_unit(unit):
+		return false
+	if state.generation != ActionHandler._action_generation or (state.director_running and not _running_director()):
+		return false
+	return unit.board_id == state.expected_board and unit.board_anchor == state.expected_anchor
diff --git a/scripts/actions/board_actions/BoardMovementDispatch.gd b/scripts/actions/board_actions/BoardMovementDispatch.gd
new file mode 100644
--- /dev/null
+++ b/scripts/actions/board_actions/BoardMovementDispatch.gd
@@ -0,0 +1,24 @@
+## Serial multi-target movement; interception and field-owner resolution happen at execution.
+extends BaseAction
+class_name BoardMovementDispatch
+
+var source: BaseAction
+var mover_ref: WeakRef
+var method: StringName
+
+func _init(action: BaseAction, unit: BaseCombatant, callback: StringName) -> void:
+	source = action
+	mover_ref = weakref(unit) if is_instance_valid(unit) else null
+	method = callback
+	inherit_execution_context(source)
+
+func perform_action() -> void:
+	if not source.prepare_execution():
+		return
+	var unit: BaseCombatant = mover_ref.get_ref() if mover_ref != null else null
+	if not is_instance_valid(unit) or not unit.is_alive():
+		return
+	var board: BoardData = BoardData.get_for_unit(unit)
+	if board != null:
+		for processor: ActionInterceptorProcessor in source._intercept_action([unit]):
+			source.call(method, board, unit, processor)
diff --git a/scripts/actions/board_actions/BoardTransferAction.gd b/scripts/actions/board_actions/BoardTransferAction.gd
new file mode 100644
--- /dev/null
+++ b/scripts/actions/board_actions/BoardTransferAction.gd
@@ -0,0 +1,135 @@
+## Atomic board placement followed by guarded old-board leave and new-board enter events.
+## Geometry cannot be half-committed by a synchronous signal or a lethal field reaction.
+extends BaseAction
+class_name BoardTransferAction
+
+var source: BaseAction
+var unit_ref: WeakRef
+var old_board_ref: WeakRef
+var new_board_ref: WeakRef
+var old_anchor: Vector2i
+var new_anchor: Vector2i
+var expected_generation: int
+var originally_running: bool
+var stage: int = 0
+var ignore_zoc: bool = false
+var forced: bool = false
+var old_controllers: Array[BaseCombatant] = []
+
+static func move_unit(action: BaseAction, unit: BaseCombatant, target_board_id: String, target_cell: Vector2i, is_forced: bool, zoc_ignored: bool) -> void:
+	var director: CombatDirector = Global.get_combat_director()
+	if director == null or director.battlefield == null:
+		return
+	var old_board: BoardData = director.battlefield.get_board_for_unit(unit)
+	var new_board: BoardData = director.battlefield.get_board(target_board_id)
+	if old_board == null or new_board == null or old_board == new_board:
+		return
+	var from: Vector2i = unit.board_anchor
+	var controllers: Array[BaseCombatant] = old_board.zoc_controllers(unit, from, zoc_ignored, is_forced)
+	if not director.battlefield.transfer(unit, BoardPosition.new(target_board_id, target_cell)):
+		return
+	old_board.invalidate_undo(unit)
+	new_board.invalidate_undo(unit)
+	# A cross-board placement is one transfer, never a fictitious distance between local cells.
+	if is_forced:
+		unit.cells_displaced_this_action += 1
+	else:
+		unit.cells_moved_this_action += 1
+	_record(action, 1, is_forced)
+	var event: BoardTransferAction = _event(action, unit, old_board, new_board, from, target_cell, is_forced, zoc_ignored)
+	event.old_controllers = controllers
+	Signals.unit_board_moved.emit(unit, old_board.board_id, from, new_board.board_id, target_cell)
+	if event._valid(unit, old_board, new_board):
+		ActionHandler.add_ordered_actions([event])
+
+static func swap_units(action: BaseAction, unit_a: BaseCombatant, unit_b: BaseCombatant, zoc_ignored: bool) -> void:
+	var director: CombatDirector = Global.get_combat_director()
+	if director == null or director.battlefield == null:
+		return
+	var board_a: BoardData = director.battlefield.get_board_for_unit(unit_a)
+	var board_b: BoardData = director.battlefield.get_board_for_unit(unit_b)
+	if board_a == null or board_b == null:
+		return
+	var from_a: Vector2i = unit_a.board_anchor
+	var from_b: Vector2i = unit_b.board_anchor
+	var controllers_a: Array[BaseCombatant] = board_a.zoc_controllers(unit_a, from_a, zoc_ignored, true)
+	var controllers_b: Array[BaseCombatant] = board_b.zoc_controllers(unit_b, from_b, zoc_ignored, true)
+	if not director.battlefield.swap(unit_a, unit_b):
+		return
+	board_a.invalidate_undo(unit_a)
+	board_a.invalidate_undo(unit_b)
+	board_b.invalidate_undo(unit_a)
+	board_b.invalidate_undo(unit_b)
+	var amount: int = 1 if board_a != board_b else board_a.distance(from_a, from_b)
+	unit_a.cells_displaced_this_action += amount
+	unit_b.cells_displaced_this_action += amount
+	_record(action, amount, true)
+	var first: BoardTransferAction = _event(action, unit_a, board_a, board_b, from_a, from_b, true, zoc_ignored)
+	var second: BoardTransferAction = _event(action, unit_b, board_b, board_a, from_b, from_a, true, zoc_ignored)
+	first.old_controllers = controllers_a
+	second.old_controllers = controllers_b
+	Signals.unit_board_moved.emit(unit_a, board_a.board_id, from_a, board_b.board_id, from_b)
+	if second._valid(unit_b, board_b, board_a):
+		Signals.unit_board_moved.emit(unit_b, board_b.board_id, from_b, board_a.board_id, from_a)
+	var events: Array[BaseAction] = []
+	if first._valid(unit_a, board_a, board_b):
+		events.append(first)
+	if second._valid(unit_b, board_b, board_a):
+		events.append(second)
+	ActionHandler.add_ordered_actions(events)
+
+static func _event(action: BaseAction, unit: BaseCombatant, old_board: BoardData, new_board: BoardData, from: Vector2i, to: Vector2i, is_forced: bool, zoc_ignored: bool) -> BoardTransferAction:
+	var result := BoardTransferAction.new()
+	result.source = action
+	result.inherit_execution_context(action)
+	result.unit_ref = weakref(unit)
+	result.old_board_ref = weakref(old_board)
+	result.new_board_ref = weakref(new_board)
+	result.old_anchor = from
+	result.new_anchor = to
+	result.expected_generation = ActionHandler._action_generation
+	result.originally_running = director_running()
+	result.forced = is_forced
+	result.ignore_zoc = zoc_ignored
+	return result
+
+static func _record(action: BaseAction, amount: int, is_forced: bool) -> void:
+	if action.card_play_request != null:
+		var key: String = "displaced_cells" if is_forced else "moved_cells"
+		action.card_play_request.card_values[key] = int(action.card_play_request.card_values.get(key, 0)) + amount
+
+static func director_running() -> bool:
+	var director: CombatDirector = Global.get_combat_director()
+	return director != null and director.is_running
+
+func perform_action() -> void:
+	if not source.prepare_execution() or not prepare_execution():
+		return
+	var unit: BaseCombatant = unit_ref.get_ref()
+	var old_board: BoardData = old_board_ref.get_ref()
+	var new_board: BoardData = new_board_ref.get_ref()
+	if not _valid(unit, old_board, new_board):
+		return
+	var children: Array[BaseAction] = []
+	if stage == 0:
+		children = old_board.movement_state.opportunity_actions_from_controllers(old_board, unit, old_controllers, source)
+	elif stage == 1:
+		if old_board.field_controller != null and old_board.field_controller.get_ref() != null:
+			children = old_board.field_controller.get_ref().make_transfer_actions(unit, old_anchor, false, source)
+	elif stage == 2:
+		if new_board.field_controller != null and new_board.field_controller.get_ref() != null:
+			children = new_board.field_controller.get_ref().make_transfer_actions(unit, new_anchor, true, source)
+	else:
+		Signals.unit_moved.emit(unit, old_anchor, new_anchor)
+		return
+	if not _valid(unit, old_board, new_board):
+		return
+	var continuation: BoardTransferAction = _event(source, unit, old_board, new_board, old_anchor, new_anchor, forced, ignore_zoc)
+	continuation.expected_generation = expected_generation
+	continuation.originally_running = originally_running
+	continuation.stage = stage + 1
+	children.append(continuation)
+	ActionHandler.add_ordered_actions(children)
+
+func _valid(unit: BaseCombatant, old_board: BoardData, new_board: BoardData) -> bool:
+	return is_instance_valid(unit) and unit.is_alive() and old_board != null and new_board != null and new_board.has_unit(unit) and unit.board_anchor == new_anchor and expected_generation == ActionHandler._action_generation and (not originally_running or director_running())
diff --git a/scripts/combat/board/BoardActionGeometry.gd b/scripts/combat/board/BoardActionGeometry.gd
new file mode 100644
--- /dev/null
+++ b/scripts/combat/board/BoardActionGeometry.gd
@@ -0,0 +1,107 @@
+## Pre-payment geometry checks, including conditional/nested action payloads. This is
+## conservative: both branches must be safe, since earlier effects can change the predicate.
+extends RefCounted
+class_name BoardActionGeometry
+
+static func check(board: BoardData, parent: BaseCombatant, cell: Vector2i, data: Variant, context_values: Dictionary = {}, depth: int = 0) -> String:
+	if depth > 32:
+		return "action_geometry_depth_exceeded"
+	if data is Array:
+		for entry: Variant in data:
+			var error: String = check(board, parent, cell, entry, context_values, depth + 1)
+			if error != "":
+				return error
+	elif data is Dictionary:
+		for key: Variant in data:
+			var value: Variant = data[key]
+			if value is Dictionary:
+				# Wrapper children can live in card/request values and use custom key names.
+				var child_keys: Array[String] = []
+				if str(key) == Scripts.ACTION_VALIDATOR:
+					child_keys.assign(["passed_action_data", "failed_action_data"])
+				elif str(key).ends_with("/ActionVariableActionGenerator.gd"):
+					child_keys.assign(["action_data"])
+				elif str(key).ends_with("/ActionRandomSelection.gd"):
+					child_keys.assign(["weighted_action_data"])
+				for child_key: String in child_keys:
+					var child_error: String = check(board, parent, cell, _value(value, context_values, child_key, []), context_values, depth + 1)
+					if child_error != "":
+						return child_error
+				var action_error: String = _check_action(board, parent, cell, str(key), value, context_values)
+				if action_error != "":
+					return action_error
+			var nested_error: String = check(board, parent, cell, value, context_values, depth + 1)
+			if nested_error != "":
+				return nested_error
+	return ""
+
+static func _value(values: Dictionary, context: Dictionary, name: String, fallback: Variant) -> Variant:
+	var names: Dictionary = values.get("custom_key_names", {})
+	var key: String = str(names.get(name, name))
+	return values.get(key, context.get(key, fallback))
+
+static func _check_action(board: BoardData, parent: BaseCombatant, cell: Vector2i, path: String, values: Dictionary, context: Dictionary) -> String:
+	if path not in [Scripts.ACTION_COMPUTE_BOARD_VALUE, Scripts.ACTION_DISPLACE_UNIT, Scripts.ACTION_MOVE_UNIT]:
+		return ""
+	var movement: String = str(_value(values, context, "mode", "PUSH")) if path == Scripts.ACTION_DISPLACE_UNIT else ""
+	if path == Scripts.ACTION_DISPLACE_UNIT:
+		var override_error: String = _override_error(board, parent, values, context, movement)
+		if override_error != "":
+			return override_error
+		var override: int = int(_value(values, context, "target_override", BaseAction.TARGET_OVERRIDES.SELECTED_TARGETS))
+		if override not in [BaseAction.TARGET_OVERRIDES.SELECTED_TARGETS, BaseAction.TARGET_OVERRIDES.RESOLVED_SHAPE]:
+			movement = "" # The selected cell does not determine this override's targets.
+	var query: Dictionary = BoardTargeting.geometry(board, parent, cell, BoardTargeting.TARGET_SHAPES.SINGLE, -1, movement)
+	if not query.valid:
+		return query.error
+	if not query.cross_board:
+		return ""
+	if path == Scripts.ACTION_COMPUTE_BOARD_VALUE:
+		return "cross_board_distance_undefined"
+	if path != Scripts.ACTION_MOVE_UNIT:
+		return ""
+	var mode: String = str(_value(values, context, "mode", "TO_CELL"))
+	var target_board_id: String = str(_value(values, context, "target_board_id", ""))
+	var teleport: bool = mode == "TELEPORT" or not bool(_value(values, context, "use_path", true))
+	if target_board_id == "SELECTED":
+		target_board_id = board.board_id
+	if target_board_id != "" and target_board_id != parent.board_id:
+		return "" if teleport else "cross_board_walk_unsupported"
+	if mode in ["TOWARD", "AWAY"]:
+		var reference: String = str(_value(values, context, "reference", "SELECTED_TARGET"))
+		if reference == "SELECTED_TARGET":
+			return "cross_board_direction_unsupported"
+		if reference == "HERO":
+			var hero: BaseCombatant = UnitRegistry.get_hero()
+			if hero != null and hero.board_id != parent.board_id:
+				return "cross_board_direction_unsupported"
+		return ""
+	# A selected cell on another board cannot silently become the same coordinate locally.
+	if _value(values, context, "target_cell", null) == null:
+		return "cross_board_move_requires_destination"
+	return ""
+
+## Resolve all possible global targets without drawing RNG. The actual action still validates
+## again after any earlier queued effect changes membership or position.
+static func _override_error(board: BoardData, parent: BaseCombatant, values: Dictionary, context: Dictionary, movement: String) -> String:
+	var override: int = int(_value(values, context, "target_override", BaseAction.TARGET_OVERRIDES.SELECTED_TARGETS))
+	if override in [BaseAction.TARGET_OVERRIDES.SELECTED_TARGETS, BaseAction.TARGET_OVERRIDES.RESOLVED_SHAPE]:
+		return ""
+	var action_values: Dictionary[String, Variant] = {}
+	action_values.assign(values)
+	var names: Dictionary = values.get("custom_key_names", {})
+	var override_key: String = str(names.get("target_override", "target_override"))
+	if override == BaseAction.TARGET_OVERRIDES.RANDOM_OPPONENT:
+		action_values[override_key] = BaseAction.TARGET_OVERRIDES.ALL_OPPONENTS
+	elif override == BaseAction.TARGET_OVERRIDES.RANDOM_ENEMY:
+		action_values[override_key] = BaseAction.TARGET_OVERRIDES.ALL_ENEMIES
+	var request := CardPlayRequest.new()
+	request.card_values = context.duplicate()
+	var probe := BaseAction.new()
+	probe.init(parent, request, [], action_values)
+	for candidate: BaseCombatant in probe.get_adjusted_action_targets():
+		var target_board: BoardData = board if board.has_unit(candidate) else BoardData.get_for_unit(candidate)
+		var query: Dictionary = BoardTargeting.geometry(target_board, parent, candidate.board_anchor, BoardTargeting.TARGET_SHAPES.SINGLE, -1, movement)
+		if not query.valid:
+			return query.error
+	return ""
diff --git a/scripts/combat/board/BoardMovementState.gd b/scripts/combat/board/BoardMovementState.gd
new file mode 100644
--- /dev/null
+++ b/scripts/combat/board/BoardMovementState.gd
@@ -0,0 +1,97 @@
+## Per-timeline-action ZOC deduplication and conservative movement undo snapshots.
+extends RefCounted
+class_name BoardMovementState
+
+var used_opportunities: Dictionary = {}
+var undo_snapshots: Dictionary = {}
+var undo_blocked: Dictionary = {}
+
+func reset() -> void:
+	used_opportunities.clear()
+	undo_snapshots.clear()
+	undo_blocked.clear()
+
+func invalidate(unit: BaseCombatant) -> void:
+	if unit != null:
+		undo_blocked[unit.unit_uid] = true
+		undo_snapshots.erase(unit.unit_uid)
+
+func capture(unit: BaseCombatant) -> void:
+	if undo_blocked.has(unit.unit_uid) or undo_snapshots.has(unit.unit_uid):
+		return
+	undo_snapshots[unit.unit_uid] = {"board_id": unit.board_id, "anchor": unit.board_anchor, "points": unit.move_points, "paid": unit.paid_cells_this_action, "delay": unit.action_extra_delay, "moved": unit.cells_moved_this_action}
+
+func can_undo(board: BoardData, unit: BaseCombatant) -> bool:
+	return unit != null and board.has_unit(unit) and unit.is_alive() and board.rules.move_undo_allowed and undo_snapshots.has(unit.unit_uid) and not undo_blocked.has(unit.unit_uid) and unit.board_id == undo_snapshots[unit.unit_uid].board_id and unit.board_anchor != undo_snapshots[unit.unit_uid].anchor and board.can_stand(unit, undo_snapshots[unit.unit_uid].anchor)
+
+func undo(board: BoardData, unit: BaseCombatant) -> bool:
+	if not can_undo(board, unit):
+		return false
+	var snapshot: Dictionary = undo_snapshots[unit.unit_uid]
+	var from: Vector2i = unit.board_anchor
+	if not board.move(unit, snapshot.anchor):
+		return false
+	unit.move_points = snapshot.points
+	unit.paid_cells_this_action = snapshot.paid
+	unit.action_extra_delay = snapshot.delay
+	unit.cells_moved_this_action = snapshot.moved
+	undo_snapshots.erase(unit.unit_uid)
+	Signals.unit_board_moved.emit(unit, board.board_id, from, board.board_id, snapshot.anchor)
+	if board.has_unit(unit) and unit.board_anchor == snapshot.anchor:
+		Signals.unit_moved.emit(unit, from, snapshot.anchor)
+		Signals.timeline_changed.emit()
+	return true
+
+func zoc_controllers(board: BoardData, unit: BaseCombatant, from: Vector2i, ignore_zoc: bool, forced: bool) -> Array[BaseCombatant]:
+	var result: Array[BaseCombatant] = []
+	if unit == null or unit.ignores_zoc or ignore_zoc or board.rules.zone_of_control == CombatRulesData.ZOC_MODES.NONE:
+		return result
+	if forced and not board.rules.zoc_triggers_on_forced_move:
+		return result
+	for other: BaseCombatant in board.get_units():
+		if other == unit or not other.is_alive() or other.faction == unit.faction or other.faction == BaseCombatant.FACTIONS.NEUTRAL:
+			continue
+		if board.unit_distance(unit, other, from) == 1:
+			result.append(other)
+	return result
+
+func opportunity_actions(board: BoardData, unit: BaseCombatant, from: Vector2i, ignore_zoc: bool, forced: bool, source: BaseAction) -> Array[BaseAction]:
+	var result: Array[BaseAction] = []
+	if board.rules.zone_of_control != CombatRulesData.ZOC_MODES.OPPORTUNITY_ATTACK:
+		return result
+	return opportunity_actions_from_controllers(board, unit, zoc_controllers(board, unit, from, ignore_zoc, forced), source)
+
+func opportunity_actions_from_controllers(board: BoardData, unit: BaseCombatant, controllers: Array[BaseCombatant], source: BaseAction) -> Array[BaseAction]:
+	var result: Array[BaseAction] = []
+	if board.rules.zone_of_control != CombatRulesData.ZOC_MODES.OPPORTUNITY_ATTACK:
+		return result
+	var generation: int = ActionHandler._action_generation
+	for other: BaseCombatant in controllers:
+		if not is_instance_valid(other) or not other.is_alive() or not board.has_unit(other):
+			continue
+		var key: String = other.unit_uid + ":" + unit.unit_uid
+		if used_opportunities.has(key) or other.opportunity_actions.is_empty():
+			continue
+		used_opportunities[key] = true
+		invalidate(unit)
+		Signals.unit_left_zoc.emit(unit, other)
+		if generation != ActionHandler._action_generation or not is_instance_valid(unit) or not unit.is_alive():
+			return []
+		if not is_instance_valid(other) or not other.is_alive() or not board.has_unit(other):
+			continue
+		for child: BaseAction in ActionGenerator.create_actions(other, null, [unit], other.opportunity_actions, source):
+			# A field can cause the move, but the opportunity attack belongs to its controller.
+			child.field_owner_bound = true
+			child.field_owner_uid = other.unit_uid
+			result.append(child)
+	return result
+
+func preview_damage(board: BoardData, unit: BaseCombatant, from: Vector2i, ignore_zoc: bool, forced: bool) -> int:
+	if board.rules.zone_of_control != CombatRulesData.ZOC_MODES.OPPORTUNITY_ATTACK:
+		return 0
+	var state: Dictionary = {"block": float(unit.get_block()), "total": 0.0}
+	for other: BaseCombatant in zoc_controllers(board, unit, from, ignore_zoc, forced):
+		if used_opportunities.has(other.unit_uid + ":" + unit.unit_uid):
+			continue
+		FieldPreview.preview_actions_into(other.opportunity_actions, other, unit, state, true, false)
+	return int(state.total)
diff --git a/scripts/combat/board/BoardPathfinding.gd b/scripts/combat/board/BoardPathfinding.gd
new file mode 100644
--- /dev/null
+++ b/scripts/combat/board/BoardPathfinding.gd
@@ -0,0 +1,157 @@
+## Pure deterministic terrain / occupancy / control-zone movement queries.
+extends RefCounted
+class_name BoardPathfinding
+
+const DIAGONALS: Array[Vector2i] = [Vector2i(1, -1), Vector2i(1, 1), Vector2i(-1, 1), Vector2i(-1, -1)]
+
+static func can_pass(board: BoardData, unit: BaseCombatant, anchor: Vector2i, override_flying: Variant = null) -> bool:
+	var flying: bool = unit.ignores_occupancy if override_flying == null else bool(override_flying)
+	for cell: Vector2i in BoardData.footprint_cells(anchor, unit.footprint):
+		if not board.is_in_bounds(cell):
+			return false
+		if flying:
+			continue
+		if not board.is_cell_enterable(cell, unit):
+			return false
+		var occupant: BaseCombatant = board.get_unit_at(cell)
+		if occupant == null or occupant == unit:
+			continue
+		if occupant.faction == unit.faction and board.rules.move_pass_through_allies:
+			continue
+		if occupant.faction != unit.faction and occupant.faction != BaseCombatant.FACTIONS.NEUTRAL and board.rules.move_pass_through_enemies:
+			continue
+		return false
+	return true
+
+static func neighbours(board: BoardData) -> Array[Vector2i]:
+	var offsets: Array[Vector2i] = BoardData.NEIGHBOURS_FOUR.duplicate()
+	if board.rules.move_adjacency == CombatRulesData.MOVE_ADJACENCY.EIGHT:
+		offsets.append_array(DIAGONALS)
+	return offsets
+
+static func step_cost(board: BoardData, unit: BaseCombatant, from: Vector2i, to: Vector2i, ignore_zoc: bool = false) -> int:
+	var cost: int = 1
+	for cell: Vector2i in BoardData.footprint_cells(to, unit.footprint):
+		var data: BoardCellData = board.get_cell(cell)
+		if data == null:
+			return 1 << 20
+		var cell_cost: int = max(1, data.move_cost)
+		for instance: FieldInstance in board.get_fields(cell):
+			if instance.field_data.field_move_cost_override >= 0:
+				cell_cost = max(1, instance.field_data.field_move_cost_override)
+		cost = max(cost, cell_cost)
+	if board.rules.zone_of_control == CombatRulesData.ZOC_MODES.EXTRA_MOVE_COST and not board.zoc_controllers(unit, from, ignore_zoc).is_empty():
+		cost += max(0, board.rules.zoc_extra_move_cost)
+	return cost
+
+static func reachable(board: BoardData, unit: BaseCombatant, budget: int, ignore_occupancy: Variant, ignore_zoc: bool) -> Dictionary:
+	var result: Dictionary = {}
+	if unit == null or not board.has_unit(unit):
+		return result
+	var start: Vector2i = unit.board_anchor
+	var parents: Dictionary = {start: start}
+	var costs: Dictionary = {start: 0}
+	var frontier: Array[Vector2i] = [start]
+	result[start] = [] as Array[Vector2i]
+	while not frontier.is_empty():
+		var best_index: int = 0
+		for index: int in range(1, frontier.size()):
+			if costs[frontier[index]] < costs[frontier[best_index]]:
+				best_index = index
+		var current: Vector2i = frontier[best_index]
+		frontier.remove_at(best_index)
+		for offset: Vector2i in neighbours(board):
+			var next: Vector2i = current + offset
+			if not can_pass(board, unit, next, ignore_occupancy):
+				continue
+			var cost: int = costs[current] + step_cost(board, unit, current, next, ignore_zoc)
+			if budget >= 0 and cost > budget:
+				continue
+			if costs.has(next) and costs[next] <= cost:
+				continue
+			costs[next] = cost
+			parents[next] = current
+			if not frontier.has(next):
+				frontier.append(next)
+			if board.can_stand(unit, next):
+				var path: Array[Vector2i] = []
+				var cursor: Vector2i = next
+				while cursor != start:
+					path.push_front(cursor)
+					cursor = parents[cursor]
+				result[next] = path
+	return result
+
+## Paid movement buys a physical step, not each point of expensive terrain.
+## Keep resource states separately: a cheapest-cost path may consume more paid cells.
+static func reachable_active(board: BoardData, unit: BaseCombatant, ignore_zoc: bool = false, max_steps: int = -1) -> Dictionary:
+	var result: Dictionary = {}
+	if unit == null or not board.has_unit(unit):
+		return result
+	var start: Dictionary = {"cell": unit.board_anchor, "free": unit.move_points, "paid": max(0, board.rules.paid_move_max_cells - unit.paid_cells_this_action), "cost": 0, "path": []}
+	var frontier: Array[Dictionary] = [start]
+	var seen: Dictionary = {}
+	var best_cost: Dictionary = {}
+	while not frontier.is_empty():
+		var best: int = 0
+		for index: int in range(1, frontier.size()):
+			if frontier[index].cost < frontier[best].cost:
+				best = index
+		var entry: Dictionary = frontier[best]
+		frontier.remove_at(best)
+		var key: String = str(entry.cell) + ":" + str(entry.free) + ":" + str(entry.paid) + (":" + str(entry.path.size()) if max_steps >= 0 else "")
+		if seen.has(key):
+			continue
+		seen[key] = true
+		if board.can_stand(unit, entry.cell) and (not best_cost.has(entry.cell) or entry.cost < best_cost[entry.cell]):
+			result[entry.cell] = entry.path
+			best_cost[entry.cell] = entry.cost
+		if max_steps >= 0 and entry.path.size() >= max_steps:
+			continue
+		for offset: Vector2i in neighbours(board):
+			var next: Vector2i = entry.cell + offset
+			if not can_pass(board, unit, next):
+				continue
+			var cost: int = step_cost(board, unit, entry.cell, next, ignore_zoc)
+			var paid: int = entry.paid - (1 if entry.free < cost else 0)
+			if paid < 0:
+				continue
+			var path: Array = entry.path.duplicate()
+			path.append(next)
+			frontier.append({"cell": next, "free": max(0, int(entry.free) - cost), "paid": paid, "cost": entry.cost + cost, "path": path})
+	return result
+
+## Card movement limits physical steps while terrain still chooses the cheapest legal path.
+static func reachable_steps(board: BoardData, unit: BaseCombatant, max_steps: int, ignore_zoc: bool = false) -> Dictionary:
+	if max_steps < 0:
+		return reachable(board, unit, -1, null, ignore_zoc)
+	var result: Dictionary = {}
+	if unit == null or not board.has_unit(unit):
+		return result
+	var frontier: Array[Dictionary] = [{"cell": unit.board_anchor, "cost": 0, "path": []}]
+	var seen: Dictionary = {}
+	var best_cost: Dictionary = {}
+	while not frontier.is_empty():
+		var best: int = 0
+		for index: int in range(1, frontier.size()):
+			if frontier[index].cost < frontier[best].cost:
+				best = index
+		var entry: Dictionary = frontier[best]
+		frontier.remove_at(best)
+		var key: String = str(entry.cell) + ":" + str(entry.path.size())
+		if seen.has(key):
+			continue
+		seen[key] = true
+		if board.can_stand(unit, entry.cell) and (not best_cost.has(entry.cell) or entry.cost < best_cost[entry.cell]):
+			result[entry.cell] = entry.path
+			best_cost[entry.cell] = entry.cost
+		if entry.path.size() >= max_steps:
+			continue
+		for offset: Vector2i in neighbours(board):
+			var next: Vector2i = entry.cell + offset
+			if not can_pass(board, unit, next):
+				continue
+			var path: Array = entry.path.duplicate()
+			path.append(next)
+			frontier.append({"cell": next, "cost": entry.cost + step_cost(board, unit, entry.cell, next, ignore_zoc), "path": path})
+	return result
diff --git a/scripts/combat/board/BoardPosition.gd b/scripts/combat/board/BoardPosition.gd
