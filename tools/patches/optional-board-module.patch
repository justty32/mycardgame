+## Module-owned card options. New content uses card_values.board; old saves/packs
+## retain their scalar fields as compatibility fallbacks without involving the card core.
+extends RefCounted
+class_name BoardCardOptions
+
+static func options(card: CardData) -> Dictionary:
+	if card == null:
+		return {}
+	var value: Variant = card.card_values.get("board", {})
+	return value if value is Dictionary else {}
+
+static func range_of(card: CardData) -> int:
+	return int(options(card).get("range", card.card_range))
+
+static func shape_of(card: CardData) -> int:
+	return int(options(card).get("shape", card.card_shape))
+
+static func faction_of(card: CardData) -> int:
+	return int(options(card).get("target_faction", card.card_target_faction))
diff --git a/scripts/combat/board/BoardCombatModule.gd b/scripts/combat/board/BoardCombatModule.gd
new file mode 100644
--- /dev/null
+++ b/scripts/combat/board/BoardCombatModule.gd
@@ -0,0 +1,163 @@
+## Optional combat component, composed by Combat rather than by the CTB core.
+## An unmounted combat has no BoardController, FieldController or ThreatPreview.
+extends Node
+class_name BoardCombatModule
+
+var director: CombatDirector = null
+var board_controller: BoardController = null
+var threat_preview: ThreatPreview = null
+var presentation: BoardCombatPresentation = null
+## Changes on every clear/setup; queued requests cannot survive reuse of this same Node.
+var generation: int = 0
+## Retained weakly after clear so a later tree exit can detach the old instance safely.
+var _director_ref: WeakRef = null
+
+func setup(combat_director: CombatDirector, encounter: EncounterData) -> bool:
+	clear()
+	director = combat_director
+	_director_ref = weakref(combat_director)
+	board_controller = BoardController.new(director.rules)
+	if not board_controller.setup(encounter):
+		clear()
+		return false
+	threat_preview = ThreatPreview.new(director)
+	Signals.unit_moved.connect(_on_unit_moved)
+	Signals.field_created.connect(_on_field_changed)
+	Signals.field_removed.connect(_on_field_changed)
+	Signals.field_changed.connect(_on_field_changed)
+	Signals.board_changed.connect(_on_board_changed)
+	presentation = BoardCombatPresentation.new()
+	add_child(presentation)
+	presentation.setup(director, self)
+	return true
+
+func clear(preserve_presentation: bool = false) -> void:
+	generation += 1
+	if Signals.unit_moved.is_connected(_on_unit_moved):
+		Signals.unit_moved.disconnect(_on_unit_moved)
+	if Signals.field_created.is_connected(_on_field_changed):
+		Signals.field_created.disconnect(_on_field_changed)
+	if Signals.field_removed.is_connected(_on_field_changed):
+		Signals.field_removed.disconnect(_on_field_changed)
+	if Signals.field_changed.is_connected(_on_field_changed):
+		Signals.field_changed.disconnect(_on_field_changed)
+	if Signals.board_changed.is_connected(_on_board_changed):
+		Signals.board_changed.disconnect(_on_board_changed)
+	if is_instance_valid(presentation):
+		if preserve_presentation:
+			presentation.stop()
+		else:
+			presentation.clear()
+			presentation.queue_free()
+			presentation = null
+	if board_controller != null:
+		# Presentation has captured the death pose. Release only this module's
+		# occupancy so a persistent hero cannot enter NONE with a stale anchor.
+		if board_controller.battlefield != null:
+			for board: BoardData in board_controller.battlefield.boards.values():
+				for unit: BaseCombatant in board.get_units():
+					board.remove(unit)
+					unit.board_id = ""
+		board_controller.clear()
+	board_controller = null
+	threat_preview = null
+	director = null
+
+func _exit_tree() -> void:
+	var attached_director: CombatDirector = _director_ref.get_ref() as CombatDirector if _director_ref != null else null
+	clear()
+	if is_instance_valid(attached_director):
+		attached_director.detach_board_module(self)
+	_director_ref = null
+
+## Admission of a regular summon. Missing board membership in mounted mode is not NONE.
+func prepare_spawned_unit(unit: BaseCombatant) -> bool:
+	if board_controller == null or board_controller.battlefield == null:
+		return false
+	if board_controller.get_board_for_unit(unit) != null:
+		return true
+	return board_controller.place_unit_nearest(unit, board_controller.default_spawn_origin())
+
+func on_unit_spawned(unit: BaseCombatant) -> void:
+	var fields: FieldController = FieldController.get_for_unit(unit)
+	if fields != null:
+		fields.on_unit_spawned(unit)
+
+func on_unit_removed(unit: BaseCombatant) -> void:
+	var current: BoardData = board_controller.get_board_for_unit(unit) if board_controller != null else null
+	if current != null:
+		current.remove(unit)
+	refresh_threats()
+
+func on_action_reset(unit: BaseCombatant) -> void:
+	if board_controller == null:
+		return
+	var allowance: int = director.rules.free_move_per_action if unit.faction == BaseCombatant.FACTIONS.PARTY else 0
+	unit.reset_action_movement(allowance)
+	board_controller.reset_action_state(unit)
+
+func on_action_started(unit: BaseCombatant) -> void:
+	var fields: FieldController = FieldController.get_for_unit(unit)
+	if fields != null:
+		fields.on_unit_action_started(unit)
+
+func advance_fields(previous_tick: int, current_tick: int) -> void:
+	if board_controller != null:
+		board_controller.advance_fields(previous_tick, current_tick)
+
+func on_card_played(unit: BaseCombatant) -> void:
+	if board_controller == null or not is_instance_valid(unit):
+		return
+	var current: BoardData = board_controller.get_board_for_unit(unit)
+	if current != null:
+		current.invalidate_undo(unit)
+	if not director.rules.move_split_allowed and unit.faction == BaseCombatant.FACTIONS.PARTY:
+		unit.move_points = 0
+		unit.paid_cells_this_action = max(unit.paid_cells_this_action, director.rules.paid_move_max_cells)
+
+func refresh_threats() -> void:
+	if director != null and director.is_running and threat_preview != null:
+		threat_preview.refresh()
+
+func _on_unit_moved(_unit: BaseCombatant, _from: Vector2i, _to: Vector2i) -> void:
+	_refresh_display()
+
+func _on_field_changed(_instance: FieldInstance) -> void:
+	_refresh_display()
+
+func _on_board_changed(_board_id: StringName) -> void:
+	_refresh_display()
+
+func _refresh_display() -> void:
+	if director != null:
+		director.refresh_threats()
+
+func perform_enemy_intent(enemy: Enemy) -> void:
+	await BoardEnemyIntent.perform_intent(director, enemy)
+
+func resolve_action_targets(action: BaseAction, override: int, force_dead: bool) -> Array[BaseCombatant]:
+	return BoardActionTargets.resolve(action, override, force_dead)
+
+func place_unit_nearest(unit: BaseCombatant, cell: Vector2i) -> bool:
+	return board_controller != null and board_controller.place_unit_nearest(unit, cell)
+
+func get_move_budget(unit: BaseCombatant) -> int:
+	return board_controller.get_move_budget(unit) if board_controller != null else 0
+
+func request_player_move(unit: BaseCombatant, cell: Vector2i, board_id: String = "") -> bool:
+	if board_controller == null or not is_instance_valid(unit) or unit.faction != BaseCombatant.FACTIONS.PARTY:
+		return false
+	if board_id != "" and board_id != unit.board_id:
+		return false
+	return board_controller.move_party_unit(unit, cell)
+
+func can_player_undo_move(unit: BaseCombatant) -> bool:
+	if board_controller == null or not is_instance_valid(unit) or unit.faction != BaseCombatant.FACTIONS.PARTY:
+		return false
+	var current: BoardData = board_controller.get_board_for_unit(unit)
+	return current != null and current.can_undo_move(unit)
+
+func request_player_undo_move(unit: BaseCombatant) -> bool:
+	if not can_player_undo_move(unit):
+		return false
+	return board_controller.get_board_for_unit(unit).undo_move(unit)
diff --git a/scripts/combat/board/BoardContentPolicy.gd b/scripts/combat/board/BoardContentPolicy.gd
new file mode 100644
--- /dev/null
+++ b/scripts/combat/board/BoardContentPolicy.gd
@@ -0,0 +1,28 @@
+## Conservative detection for optional spatial content; shared by card and intent adapters.
+## Values may contain nested wrapper payloads and aliases into request/card values.
+extends RefCounted
+class_name BoardContentPolicy
+
+static func requires_board(data: Variant, context: Dictionary = {}, depth: int = 0) -> bool:
+	if depth > 32:
+		return true # malformed/deep payloads cannot silently bypass the optional-module guard
+	if data is Array:
+		for item: Variant in data:
+			if requires_board(item, context, depth + 1):
+				return true
+	elif data is Dictionary:
+		var aliases: Dictionary = data.get("custom_key_names", {})
+		var override_key: String = str(aliases.get("target_override", "target_override"))
+		var override: Variant = data.get(override_key, context.get(override_key, -1))
+		if override in [BaseAction.TARGET_OVERRIDES.RESOLVED_SHAPE, BaseAction.TARGET_OVERRIDES.UNITS_IN_RANGE, BaseAction.TARGET_OVERRIDES.UNITS_ON_FIELD]:
+			return true
+		for key: Variant in data:
+			if str(key).contains("/board_actions/") or str(key).contains("/validators/board/"):
+				return true
+			if requires_board(data[key], context, depth + 1):
+				return true
+		# Wrapper action_data may itself be supplied only through a renamed request value.
+		for alias: Variant in aliases.values():
+			if context.has(alias) and requires_board(context[alias], context, depth + 1):
+				return true
+	return false
diff --git a/scripts/combat/board/BoardEnemyIntent.gd b/scripts/combat/board/BoardEnemyIntent.gd
new file mode 100644
--- /dev/null
+++ b/scripts/combat/board/BoardEnemyIntent.gd
@@ -0,0 +1,74 @@
+## Board-module enemy execution: resolve movement and geometry, then perform the intent.
+## Membership is re-read after reactions; a missing board rejects execution.
+extends RefCounted
+class_name BoardEnemyIntent
+
+static func perform_intent(director: CombatDirector, enemy: Enemy) -> void:
+	var generation: int = director.get_generation()
+	if not is_instance_valid(enemy) or not enemy.is_alive():
+		return
+	var board: BoardData = BoardData.get_for_unit(enemy)
+	if board == null:
+		return
+	var enemy_intent: EnemyIntentData = enemy.enemy_data.get_current_intent()
+	var target: BaseCombatant = IntentResolver.choose_target(board, enemy, enemy_intent)
+	var plan: Dictionary = IntentResolver.resolve(board, enemy, enemy_intent, target)
+	if plan.get("error", "") not in ["", "out_of_range"]:
+		enemy.keep_intent_next_action = true
+		return
+	var move_after: bool = enemy_intent != null and enemy_intent.enemy_intent_move_after
+	if not move_after:
+		await _perform_move(director, enemy, enemy_intent, plan, generation)
+		if director.is_aborted(generation) or not is_instance_valid(enemy) or not enemy.is_alive():
+			return
+		# A cell reaction can transfer the mover without killing it.
+		board = BoardData.get_for_unit(enemy)
+		if board == null:
+			return
+	var hit: Dictionary = IntentResolver.hits_from(board, enemy, enemy.board_anchor, enemy_intent, target)
+	if hit.get("error", "") not in ["", "out_of_range"]:
+		enemy.keep_intent_next_action = true
+		return
+	var can_hit: bool = hit["can_hit"]
+	if enemy_intent != null and enemy_intent.enemy_intent_number_of_attacks > 0 and not can_hit:
+		enemy.keep_intent_next_action = true
+	var enemy_actions_data: Array[Dictionary] = enemy.build_intent_actions_data(enemy_intent, director.rules.reset_block_on_action_start, can_hit)
+	# play intent sound if one exists and no attacks
+	if enemy_intent != null and enemy_intent.enemy_intent_audio_path != "" and enemy_intent.enemy_intent_number_of_attacks == 0:
+		ActionGenerator.generate_sound_action(enemy_intent.enemy_intent_audio_path, false)
+	var targets: Array[BaseCombatant] = []
+	if can_hit:
+		targets.assign(hit["targets"])
+	elif is_instance_valid(target) and target.is_alive():
+		targets.append(target)
+	var enemy_actions: Array[BaseAction] = ActionGenerator.create_actions(enemy, null, targets, enemy_actions_data, null)
+	ActionHandler.add_actions(enemy_actions)
+	await director.wait_actions(generation)
+	if move_after and not director.is_aborted(generation) and is_instance_valid(enemy) and enemy.is_alive():
+		# Custom actions can transfer either participant. Re-read membership after the wait.
+		board = BoardData.get_for_unit(enemy)
+		if board == null:
+			return
+		if not is_instance_valid(target) or not target.is_alive():
+			target = IntentResolver.choose_target(board, enemy, enemy_intent)
+		plan = IntentResolver.resolve(board, enemy, enemy_intent, target)
+		await _perform_move(director, enemy, enemy_intent, plan, generation)
+
+static func _perform_move(director: CombatDirector, enemy: Enemy, intent: EnemyIntentData, plan: Dictionary, generation: int) -> void:
+	var board: BoardData = BoardData.get_for_unit(enemy)
+	if board == null or intent == null or plan["move_cell"] == enemy.board_anchor:
+		return
+	var path: Array = plan.get("path", [])
+	var teleport: bool = intent.enemy_intent_move == EnemyIntentData.MOVE_MODES.TELEPORT
+	var values: Dictionary = {
+		"mode": ActionMoveUnit.MODE_TELEPORT if teleport else ActionMoveUnit.MODE_TO_CELL,
+		"target_cell": plan["move_cell"], "planned_path": path,
+		"distance": -1 if teleport else path.size(),
+		"target_override": BaseAction.TARGET_OVERRIDES.PARENT
+	}
+	if intent.enemy_intent_move == EnemyIntentData.MOVE_MODES.CHARGE:
+		values["path_actions"] = intent.enemy_intent_path_actions
+		values["charge"] = true
+	var move_actions: Array[BaseAction] = ActionGenerator.create_actions(enemy, null, [enemy], [{Scripts.ACTION_MOVE_UNIT: values}], null)
+	ActionHandler.add_actions(move_actions)
+	await director.wait_actions(generation)
diff --git a/scripts/ui/BoardCombatPresentation.gd b/scripts/ui/BoardCombatPresentation.gd
new file mode 100644
--- /dev/null
+++ b/scripts/ui/BoardCombatPresentation.gd
@@ -0,0 +1,132 @@
+## Optional board surfaces, actor mapping and Undo UI. No instance exists for NONE combat.
+extends Node
+class_name BoardCombatPresentation
+
+var director: CombatDirector = null
+var module: BoardCombatModule = null
+var combat: Variant = null
+var board_view: BoardView = null
+var board_views: Dictionary[String, BoardView] = {}
+var actor_presentation: BoardActorPresentation = null
+var undo_move_button: Button = null
+var _view_board_ids: Array = []
+var _stopped: bool = true
+
+func setup(value: CombatDirector, board_module: BoardCombatModule) -> void:
+	director = value
+	module = board_module
+	combat = director.get_parent()
+	_stopped = false
+	Signals.combat_ended.connect(_on_display_ended)
+	Signals.run_ended.connect(_on_display_ended)
+	actor_presentation = BoardActorPresentation.new()
+	actor_presentation.name = "BoardActorPresentation"
+	add_child(actor_presentation)
+	undo_move_button = Button.new()
+	undo_move_button.name = "UndoMoveButton"
+	undo_move_button.text = "Undo Move"
+	undo_move_button.position = Vector2(1080, 576)
+	undo_move_button.size = Vector2(112, 40)
+	undo_move_button.visible = false
+	undo_move_button.button_up.connect(_on_undo_move_button_up)
+	combat.add_child(undo_move_button)
+	if combat.card_play_adapter != null:
+		combat.card_play_adapter.bind_hand(combat.hand)
+	set_process(true)
+	sync_board_views()
+
+## Rebuild grid surfaces only; actual actor parents/registry identities remain stable.
+func sync_board_views() -> void:
+	if _stopped or director == null:
+		return
+	var battlefield: CombatBattlefield = director.battlefield
+	if battlefield == null:
+		return
+	var ids: Array = battlefield.boards.keys()
+	if ids == _view_board_ids:
+		return
+	_view_board_ids = ids.duplicate()
+	actor_presentation.clear()
+	for old_view: BoardView in board_views.values():
+		old_view.queue_free()
+	board_views.clear()
+	board_view = null
+	for index: int in ids.size():
+		var view := BoardView.new()
+		view.board_id = ids[index]
+		view.panel_position = Vector2(70 + index * 570, 170) if ids.size() > 1 else Vector2(360, 170)
+		view.position = view.panel_position
+		view.name = "BoardView_" + ids[index]
+		combat.add_child(view)
+		# Grid hit surfaces precede real actor subtrees in Control input tree order.
+		combat.move_child(view, combat.player.get_index())
+		view._resize(battlefield.get_board(ids[index]))
+		board_views[ids[index]] = view
+		if index == 0:
+			board_view = view
+	actor_presentation.views = board_views
+	actor_presentation.sync_positions(false)
+
+func _process(_delta: float) -> void:
+	if _stopped or director == null:
+		return
+	if director.is_running:
+		sync_board_views()
+	undo_move_button.visible = director.is_running and director.rules != null and director.rules.move_undo_allowed
+	undo_move_button.disabled = not director.can_player_undo_move()
+
+func _on_undo_move_button_up() -> void:
+	if not _stopped and director != null:
+		director.request_player_undo_move()
+
+## Runtime may stop on hero death before the death animation ends. Retain its final pose.
+func stop() -> void:
+	_stopped = true
+	set_process(false)
+	if is_instance_valid(combat) and combat.card_play_adapter != null:
+		combat.card_play_adapter.unbind_hand()
+	if is_instance_valid(undo_move_button):
+		undo_move_button.visible = false
+		undo_move_button.disabled = true
+	for view: BoardView in board_views.values():
+		view.set_process(false)
+		view.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		view.visible = false
+	if is_instance_valid(actor_presentation):
+		actor_presentation.set_process(false)
+		# Director handles player_killed before actor signal subscribers. Snap dead actors
+		# to their already committed target before releasing them into the retired set.
+		for state: Dictionary in actor_presentation._actors.values():
+			var unit: Variant = state["unit"]
+			if is_instance_valid(unit) and not unit.is_alive():
+				actor_presentation._on_actor_killed(unit)
+		actor_presentation.clear()
+
+func _on_display_ended() -> void:
+	clear()
+
+## Final disposal at combat/run end, new setup or scene exit restores the persistent hero.
+func clear() -> void:
+	stop()
+	if Signals.combat_ended.is_connected(_on_display_ended):
+		Signals.combat_ended.disconnect(_on_display_ended)
+	if Signals.run_ended.is_connected(_on_display_ended):
+		Signals.run_ended.disconnect(_on_display_ended)
+	if is_instance_valid(actor_presentation):
+		actor_presentation._on_display_ended()
+		actor_presentation.queue_free()
+	actor_presentation = null
+	for view: BoardView in board_views.values():
+		view.queue_free()
+	board_views.clear()
+	board_view = null
+	_view_board_ids.clear()
+	if is_instance_valid(undo_move_button):
+		undo_move_button.queue_free()
+	undo_move_button = null
+	director = null
+	module = null
+	combat = null
+
+func _exit_tree() -> void:
+	clear()
