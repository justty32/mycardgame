extends RefCounted
## Query/negative cases use public action/validator APIs; placement is declared test setup.

func run(c) -> void:
	c._arrange([[c.player, Vector2i(3, 4)]])
	await c.create_field("field_probe_enter", [[3, 4]])
	var request := CardPlayRequest.new()
	request.acting_unit = c.player
	BoardCardOptions.set_selection(request, Vector2i(3, 4), "")
	var action := BaseAction.new()
	action.init(c.player, request, [])
	var validator := ValidatorCellHasField.new()
	c._check(validator.validate(null, action, {"tag": "probe", "field_id": "field_probe_enter"}), "field validator requires tag and id on the same instance")
	c._check(not validator.validate(null, action, {"field_id": "missing"}) and validator.validate(null, action, {"field_id": "missing", "invert": true}), "field validator missing/inverted branches")
	var before: int = c.player.get_combatant_health()
	await c.run_actions(c.player, [], [{Scripts.ACTION_DIRECT_DAMAGE: {"damage": 2, "bypass_block": true, "target_override": BaseAction.TARGET_OVERRIDES.UNITS_ON_FIELD, "tag": "probe"}}])
	c._check(before - c.player.get_combatant_health() == 2, "UNITS_ON_FIELD resolves the real occupying unit through handler")
	await c.remove_fields()
	var big: BaseCombatant = c.board.get_unit_at(Vector2i(5, 0))
	await c.create_field("field_probe_enter", [[5, 0], [6, 0]])
	before = big.get_combatant_health()
	await c.run_actions(c.player, [], [{Scripts.ACTION_DIRECT_DAMAGE: {"damage": 2, "bypass_block": true, "target_override": BaseAction.TARGET_OVERRIDES.UNITS_ON_FIELD, "tag": "probe"}}])
	c._check(before - big.get_combatant_health() == 2, "UNITS_ON_FIELD deduplicates a multi-cell unit occupying two matching fields")
	await c.remove_fields()
	await c.create_field("field_probe_enter", [[3, 3]], null, {"duration_override": 0})
	c._check(c.board.get_fields(Vector2i(3, 3)).is_empty(), "zero duration field cannot linger or trigger")
	await c.create_field("missing_field_id", [[3, 3]])
	c._check(c.board.fields.is_empty(), "unknown field id does not create an invalid instance")
	await c.create_field("field_probe_enter", [[-1, 0], [99, 99]])
	c._check(c.board.fields.is_empty(), "out-of-board field cells are rejected")
	await c.create_field("field_probe_enter", [[3, 3]])
	c.board.rules.move_undo_allowed = true
	c.board.reset_action_state(c.player)
	await c.move_unit(c.player, Vector2i(3, 3))
	c._check(not c.board.can_undo_move(c.player), "a field effect makes movement non-undoable")
	c.board.rules.move_undo_allowed = false
	await c.remove_fields()
	var data := FieldData.new("field_probe_benefit")
	data.field_on_enter_actions.assign([{Scripts.ACTION_BLOCK: {"block": 3}}])
	Global.register_rod(data)
	await c.create_field("field_probe_benefit", [[3, 2]])
	var block: int = c.player.get_block()
	c._check(c.field_controller().preview_hazard(Vector2i(3, 2), c.player) == -3 and c.player.get_block() == block, "block benefit preview is negative and does not grant real block")
	await c.move_unit(c.player, Vector2i(3, 2))
	c._check(c.player.get_block() == block + 3, "benefit enter action targets the mover")
	await c.remove_fields()
	c.player.set_block(0)
